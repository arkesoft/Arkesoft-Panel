# Arkesoft — yerel geliştirme ortam değişkenleri (ROADMAP v0.0.2)
#
# `pnpm infra:up` bu dosyadan `.env` üretir (yoksa). `.env` git'e girmez.
# Değerleri doğrulamak için: `pnpm env:check`
#
# UYARI: Buradaki tüm parola ve anahtarlar YALNIZCA geliştirme içindir.
# Üretim değerleri Pulumi secret yöneticisinden gelir (ROADMAP v0.18.0).

# --- Genel -------------------------------------------------------------------
NODE_ENV=development

# Tenant alt alan adlarının kökü. Yerelde *.localhost tarayıcılar tarafından
# otomatik olarak 127.0.0.1'e çözülür; /etc/hosts'a kayıt gerekmez.
APP_BASE_DOMAIN=arkesoft.localhost

# --- PostgreSQL --------------------------------------------------------------
# POSTGRES_USER/POSTGRES_PASSWORD docker-compose'un oluşturduğu İLK rol —
# süper kullanıcı. v0.0.13'ten itibaren bu rol SADECE bootstrap (rol/sahiplik/
# GRANT kurulumu) için kullanılır; günlük migration veya çalışma zamanı
# trafiği bu rolden GEÇMEZ (bkz. DATABASE_MIGRATION_URL / DATABASE_URL altı).
POSTGRES_USER=arkesoft
POSTGRES_PASSWORD=arkesoft_dev_only
POSTGRES_DB=arkesoft
POSTGRES_PORT=5432
#
# ROADMAP v0.0.13 (K-E8) ÜÇ AYRI bağlantı dizesi getirir — roller en az
# yetkiden en çoğa:
#
#   DATABASE_URL            → `arkesoft_app`       (çalışma zamanı rolü;
#                              NOSUPERUSER, NOBYPASSRLS, hiçbir tablonun
#                              sahibi değil, yalnızca SELECT/INSERT/UPDATE/
#                              DELETE). apps/api bu URL'i okur.
#   DATABASE_MIGRATION_URL  → `arkesoft_migrator`  (CREATEDB, tabloların
#                              sahibi, migration'ları çalıştırır; shadow DB
#                              için `prisma migrate dev` bunu kullanır).
#   DATABASE_BOOTSTRAP_URL  → bootstrap süper kullanıcısı (yukarıdaki
#                              POSTGRES_USER/PASSWORD ile aynı kimlik;
#                              yalnızca `pnpm db:bootstrap` rol/GRANT
#                              kurulumunda kullanılır — opsiyonel).
#
# ÖNEMLİ (K-E8 — bilinçli fail-safe varsayım): `DATABASE_URL` v0.0.3'teki gibi
# "migration/sahip rolü" DEĞİL — TAM TERSİNE en az yetkili uygulama rolünü
# temsil eder. Gerekçe: ileride DATABASE_URL'i okuyan yeni bir servis
# (storefront SSR, worker) en az yetkili rolü alır, tablo sahibi rolünü
# almaz. `arkesoft_migrator` ve `arkesoft_app` rolleri `pnpm db:bootstrap`
# (packages/db/sql/bootstrap-roles.sql, v0.0.13/S2) ile oluşturulur — rol
# henüz yoksa bu bağlantı dizeleri "role does not exist" verir, bu beklenir.
DATABASE_URL=postgresql://arkesoft_app:arkesoft_app_dev_only@localhost:5432/arkesoft?schema=public
DATABASE_MIGRATION_URL=postgresql://arkesoft_migrator:arkesoft_migrator_dev_only@localhost:5432/arkesoft?schema=public
DATABASE_BOOTSTRAP_URL=postgresql://arkesoft:arkesoft_dev_only@localhost:5432/arkesoft?schema=public
#
# ROADMAP v0.0.14.1 — DÖRDÜNCÜ bağlantı dizesi: `arkesoft_auth`. Bu rol
# yalnızca parola hash'i / oturum belirteci / doğrulama belirteci taşıyan ÜÇ
# tabloya (account, session, verification) KOLON bazlı SELECT/INSERT/UPDATE
# yetkisine sahiptir; `app_user` üzerinde `arkesoft_app` ile aynı tablo bazlı
# SELECT/INSERT/UPDATE yetkisi vardır (DELETE yok) — başka HİÇBİR tabloya
# erişemez. apps/api'nin Better Auth entegrasyonu bu URL'i okur.
#
# ⚠ DAHA HASSAS: `arkesoft_auth`, `arkesoft_app`'ten DAHA GENİŞ bir sır
# yüzeyine erişir (tüm parola hash'leri + oturum/doğrulama belirteçleri) —
# bu değeri de aynı özenle gizli tut, loglama.
#
# ⚠⚠ KOŞULSUZ ZORUNLU — fail-fast. `DATABASE_URL`'e GERİ DÜŞÜŞ YASAK: bu
# sessiz bir güvenlik kaybı olurdu (kimlik akışı, kısıtlı yerine süper
# yetkili rolle sessizce çalışmaya devam ederdi). Tanımsızsa açılış hata ile
# düşer, `??`/`||` ile `DATABASE_URL`'e düşülmez.
#
# ⚠ OPERATÖR GEÇİŞİ (v0.0.13'ün DATABASE_URL anlam değişikliğiyle AYNI
# SINIF): mevcut bir `.env` dosyanız varsa bu satırı KENDİ ELİNİZLE ekleyin —
# `pnpm env:init` var olan `.env`'i GÜNCELLEMEZ (yalnızca yoksa oluşturur).
# Satırı ekledikten sonra `pnpm db:bootstrap`'i YENİDEN koşturun (rol ve
# GRANT'ler bu adımda kurulur).
DATABASE_AUTH_URL=postgresql://arkesoft_auth:arkesoft_auth_dev_only@localhost:5432/arkesoft?schema=public

# --- Redis -------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API (apps/api, ROADMAP v0.0.4) ------------------------------------------
# API sürecinin dinlediği port ve host. Konteyner dışı (yerel) çalışma için.
API_PORT=3000
API_HOST=0.0.0.0
# pino log seviyesi: fatal | error | warn | info | debug | trace | silent.
# Geliştirmede "debug", üretimde tipik olarak "info" kullanılır.
LOG_LEVEL=debug

# --- Meilisearch -------------------------------------------------------------
MEILI_PORT=7700
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=arkesoft_dev_master_key_change_me

# --- Nesne depolama (S3 uyumlu) ----------------------------------------------
# Geliştirme: SeaweedFS (bkz. ADR-0005). Üretim: Cloudflare R2.
S3_PORT=8333
SEAWEEDFS_MASTER_PORT=9333
S3_ENDPOINT=http://localhost:8333
S3_REGION=eu-central-1
S3_BUCKET=arkesoft-dev
S3_ACCESS_KEY_ID=arkesoft_dev
S3_SECRET_ACCESS_KEY=arkesoft_dev_secret
# SeaweedFS ve R2 sanal host adresleme yerine yol tabanlı (path-style) ister.
S3_FORCE_PATH_STYLE=true

# --- E-posta (SMTP) ----------------------------------------------------------
# Geliştirme: Mailpit. Giden e-posta dışarı çıkmaz, arayüzden okunur:
# http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAILPIT_UI_PORT=8025
MAIL_FROM_NAME=Arkesoft
MAIL_FROM_ADDRESS=noreply@arkesoft.localhost

# --- Kimlik doğrulama (apps/api, ROADMAP v0.0.5, Better Auth) ---------------
# ÖNEMLİ: Aşağıdaki değerler YALNIZCA geliştirme içindir (yukarıdaki genel
# uyarı burada da geçerli). Üretimde BETTER_AUTH_SECRET secret yöneticisinden
# gelir, bu dosyadaki değer asla kullanılmaz.
#
# Secret: 32+ karakter, URL-güvenli (yalnızca harf/rakam/alt çizgi — A-E6,
# v0.0.13 dersi): parola/anahtar değerlerinde `@`/`:`/`/` gibi karakterler
# bağlantı dizesi ayrıştırmasını bozabiliyor.
BETTER_AUTH_SECRET=arkesoft_dev_only_better_auth_secret_change_me_32plus
# Panel giriş yüzeyi platform host'udur (R1, tenant alt alan adı DEĞİL).
# `panel` packages/tenancy/src/reserved-subdomains.ts:30'da zaten rezerve
# (ROADMAP v0.0.8, T-009 — modül `apps/api/src/tenancy/` altından
# `packages/tenancy`'ye terfi etti, satır numarası değişti).
#
# DEĞİŞTİ (ROADMAP v0.0.7, T-008, ADR-0011) — ANLAMI KESKİNLEŞTİ: bu değer
# "API'nin kendi dinleme adresi" DEĞİL, **tarayıcının gördüğü platform
# orijini**dir. `same-origin.guard.ts` güvenilir orijini BUNDAN türetir ve
# Better Auth'un kendi origin kontrolü (`disableOriginCheck` dev/prod'da
# kapalı) BUNA karşı karşılaştırır — port burada admin panelinin Vite dev/
# preview sunucusunun portuyla (`PANEL_DEV_PORT`) AYNI OLMAK ZORUNDADIR; sapma
# sessiz 403 (`INVALID_ORIGIN`) üretir, belirtisi hatadan çok "giriş
# çalışmıyor"dur. v0.0.5'te API'nin kendi portuna (`:3000`) ayarlanmıştı çünkü
# o sürümde tarayıcı istemcisi yoktu; v0.0.7 ilk tarayıcı istemcisini (admin
# paneli) getiriyor ve CORS AÇILMADAN tek orijin üzerinden servis ediyor
# (ADR-0011 madde 1-2) — bu yüzden :3000 → :5173.
#
# OPERATÖR GEÇİŞİ (v0.0.13'ün DATABASE_URL anlam değişikliğiyle AYNI SINIF,
# minor): mevcut `.env` dosyalarında bu satırı elle `:5173`'e güncelleyin;
# güncellemezseniz admin panelinden giriş sessizce 403 ile reddedilir. Geri
# alma: `:3000`'e döndürüp API'yi yeniden başlatın (API dışı istemciler
# etkilenmez).
AUTH_BASE_URL=http://panel.arkesoft.localhost:5173

# --- Storefront (apps/storefront, ROADMAP v0.0.8, K17) -----------------------
# Storefront'un sunucu-taraflı tRPC çağrısının BAĞLANTI hedefi (apps/api'nin
# iç ağ adresi) — URL'in YETKİSİ (authority) değil. Kiracı host'u her istekte
# `Host` başlığıyla ayrıca taşınır (K18); bu değer sabit kalır. Uygulama-yerel
# env (`packages/config` dokunulmaz, PM A5); `apps/storefront/src/lib/
# storefront-env.ts` içinde tek dosyada okunur, açılışta fail-fast.
STOREFRONT_API_BASE_URL=http://127.0.0.1:3000

# --- Kimlik doğrulama — opsiyonel (varsayılanlar architect ENV ŞEMASI'nda) --
# Hiçbiri zorunlu değil; tanımlanmazsa apps/api kendi varsayılanını kullanır.
# AUTH_COOKIE_DOMAIN=.arkesoft.localhost
# AUTH_SESSION_TTL_SECONDS=604800
# AUTH_VERIFICATION_TTL_SECONDS=3600
# AUTH_LOGIN_RATE_WINDOW_SECONDS=900
# AUTH_RESET_RATE_WINDOW_SECONDS=3600
# AUTH_TRUSTED_PROXY_COUNT=0
