{
  // Tip kontrolü projesi: src/ kaynakları (testler dahil) + kök düzeyindeki
  // yapılandırma dosyaları (vitest.config.ts) denetlenir. Derleme için ayrı
  // proje kullanılır: tsconfig.build.json (packages/errors deseni, ROADMAP
  // v0.0.6, T-007/ST-3 (S4)).
  "extends": "@arkesoft/config/tsconfig/node.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
