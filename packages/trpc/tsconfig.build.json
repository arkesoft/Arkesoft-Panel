{
  // Derleme projesi: yalnızca src/ TypeScript kaynaklarını dist/'e üretir.
  // Testler (`src/__tests__/**`) derlenmez — paket yalnızca üretim kodunu
  // dağıtır (`packages/errors/tsconfig.build.json` deseninin kopyası,
  // ROADMAP v0.0.6, T-007/ST-3 (S4)).
  "extends": "@arkesoft/config/tsconfig/node.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/__tests__"]
}
