{
  // Tip kontrolü projesi: hem TypeScript kaynakları (src) hem de JSDoc ile
  // tiplenmiş araç yapılandırmaları (eslint, prettier) denetlenir.
  // Derleme için ayrı proje kullanılır: tsconfig.build.json
  "extends": "./tsconfig/node.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "eslint/**/*.js", "prettier/**/*.js"],
  "exclude": ["node_modules", "dist"]
}
