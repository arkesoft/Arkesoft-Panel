{
  // Bu paket JSDoc ile tiplenmiş .js dosyalarından oluşur (ESLint ve Prettier
  // yapılandırmaları TypeScript'e derlenmez; araçlar bunları doğrudan çalıştırır).
  // Yine de tsc ile denetlenir: preset'lerdeki JSDoc hataları burada yakalanır.
  "extends": "./tsconfig/node.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    // JSDoc'ta ESLint/typescript-eslint tiplerini kullanabilmek için gerekli.
    "types": ["node"]
  },
  "include": ["eslint/**/*.js", "prettier/**/*.js"],
  "exclude": ["node_modules", "dist"]
}
