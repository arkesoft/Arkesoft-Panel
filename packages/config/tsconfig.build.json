{
  // Derleme projesi: yalnızca src/ TypeScript kaynaklarını dist/'e üretir.
  // ESLint ve Prettier yapılandırmaları (.js) derlenmez; araçlar onları
  // doğrudan çalıştırır.
  "extends": "./tsconfig/node.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*"],
  // `src/__tests__` — T-015 FIX turu 1, madde 3: tip pin'leri (`*.pin.ts`)
  // `pnpm typecheck`'in derlemesinden kanıt alır (`tsconfig.json`'un
  // `include`'u onları KAPSAR), ama üretim paketine (`dist/`) GİRMEMELİ —
  // `packages/db/tsconfig.build.json`'un AYNI, önceden var olan deseni.
  "exclude": ["node_modules", "dist", "src/__tests__"]
}
