{
  "name": "@arkesoft/config",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "description": "Paylaşılan tsconfig, ESLint, Prettier, Tailwind preset'leri ve ortam değişkeni şemaları",
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./tsconfig/react.json": "./tsconfig/react.json",
    "./eslint/base": "./eslint/base.js",
    "./eslint/node": "./eslint/node.js",
    "./eslint/react": "./eslint/react.js",
    "./prettier": "./prettier/index.js",
    "./tailwind/theme.css": "./tailwind/theme.css",
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./dist/env.js"
    }
  },
  "files": [
    "dist",
    "eslint",
    "prettier",
    "tailwind",
    "tsconfig"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --declaration --declarationMap",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "typescript-eslint": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "eslint": ">=10.0.0",
    "typescript": ">=5.9.0 <6.1.0"
  }
}
