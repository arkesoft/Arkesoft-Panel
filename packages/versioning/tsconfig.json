{
  // Tip kontrolü projesi: src/ kaynakları + kök düzeyindeki yapılandırma
  // dosyaları (vitest.config.ts) denetlenir. Derleme için ayrı proje
  // kullanılır: tsconfig.build.json (packages/errors deseninin birebir
  // kopyası — po'nun ölçümü: bu paket packages/errors'ın şeklini takip eder).
  "extends": "@arkesoft/config/tsconfig/node.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
