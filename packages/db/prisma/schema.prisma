// @arkesoft/db — Prisma şeması (ROADMAP v0.0.3, T-001 architect tasarımı)
//
// Ortak konvansiyon (ADR-0003):
//   - R2: `id` = `String @id @default(cuid(2))`, PostgreSQL tipi `text`, UZUNLUK SINIRI
//     YOK (`@db.VarChar` yasak), öneksiz. `@default(cuid(2))` Prisma'nın İSTEMCİ
//     tarafında üretilir, DDL'de bir `DEFAULT` ifadesi YOKTUR → ham SQL ile satır
//     eklerken `id` elle verilmek zorundadır (@paralleldrive/cuid2 eklenmez).
//   - R3: PostgreSQL'de `user` ayrılmış kelimedir (`SELECT user` bir rol döner).
//     Model adı `User` kalır (Better Auth v0.0.5 model adıyla eşler) ama tablo adı
//     `app_user`'dır — elle yazılan RLS/DDL SQL'i ve psql hata ayıklaması tırnaklı
//     `"user"`'a bağımlı kalmasın. Ayrılmış kelimeyle çakışan her platform tablosuna
//     aynı `app_` öneki konvansiyonu uygulanır.
//   - Zaman alanları `@db.Timestamptz(3)`; trigger yok, `updatedAt` istemci tarafında
//     `@updatedAt` ile yönetilir.
//   - Soft delete yalnızca VARLIK tablolarında (`Tenant`, `User`); saf ilişki tablosu
//     `TenantMembership`'te yoktur — kaldırma hard delete'tir (bkz. ADR-0003 madde 3).
//   - `Tenant` ve `User` PLATFORM SEVİYESİDİR, `tenant_id` TAŞIMAZLAR (V4). Tenant'a
//     bağlı tabloların KANONİK LİSTESİ bu dosyada DEĞİL, `src/tenancy.ts` →
//     `TENANT_SCOPED_TABLES` dizisindedir (makine okunur taksonomi; linter'lar o
//     diziyi tüketir). RLS politikaları v0.0.13'ten itibaren elle SQL olarak
//     migration'lara yazılır (bu şema dosyası RLS ÜRETMEZ — AC6 sapma riskine
//     girmesin).
//
// GÜNCELLEME (ROADMAP v0.0.5, T-006/S2 — Better Auth): `Session`/`Account`/
// `Verification` EKLENDİ, üçü de PLATFORM SEVİYESİ (`tenant_id` TAŞIMAZ) —
// gerekçe her modelin kendi doc yorumunda. `User`'a `emailVerified`/`image`
// additive alanları eklendi (A4/A-G1/A-G2, Task raporunda ÖLÇÜLDÜ). Bu üç yeni
// tablo için `(tenant_id, …)` bileşik indeks GEREKMEZ ve YAZILMAZ (platform
// tablosu). MADDE 2 — R-1 KARARI (ADR-0008 taslağı): bu üç tablonun sır taşıyan
// kolonları (`account.password`, `session.token`, `verification.value`) RLS
// İLE korunamaz (giriş/oturum arama asıldan ÖNCE gelir, `current_setting`'e
// dayalı yüklem tanımlanamaz) — koruma `src/client.ts` → `AUTH_SECRET_BEARING_MODELS`
// derleme zamanı daraltmasındadır, bu şema dosyası seviyesinde YOKTUR.
//
// GÜNCELLEME (ROADMAP v0.0.14, T-014/S1 — RBAC): `AuditLog` ve
// `TenantInvitation` EKLENDİ, ikisi de KİRACIYA BAĞLI → `src/tenancy.ts`'teki
// `TENANT_SCOPED_TABLES` İKİ üyeden DÖRT üyeye çıktı. `TenantRole` enum'u
// v0.0.3'ten beri beş rolü taşıyor, bu sürümde DEĞİŞMEDİ; yeni enum yalnızca
// `AuditAction`. `TenantInvitation` HAM BELİRTEÇ SAKLAMAZ (yalnızca sha256
// özeti) → `src/client.ts` → `AUTH_SECRET_BEARING_MODELS` ÜÇ üyede KALIR.
//
// GÜNCELLEME (ROADMAP v0.0.15, T-016/S1 — TOTP 2FA + owner zorunluluğu):
// `TwoFactor` EKLENDİ — PLATFORM SEVİYESİ (`tenant_id` TAŞIMAZ, gerekçe
// modelin kendi doc yorumunda) → `TENANT_SCOPED_TABLES` DÖRTTE KALIR, yeni
// izolasyon probu YAZILMAZ. `User.twoFactorEnabled` ve
// `Tenant.requireTwoFactorForOwner` additive kolonlar olarak EKLENDİ
// (ikisi de `Boolean @default(false)`, NOT NULL — yıkıcı DEĞİL, yeni satırın
// varsayılanı). `AuditAction`'a `tenant_security_policy_changed` EKLENDİ
// (kiracı seviyesi zorunluluk DEĞİŞİKLİĞİ denetlenir; kullanıcı seviyesi 2FA
// olayı `AuditLog.tenantId` NOT NULL olduğu için YAPISAL olarak alınamaz).
// `TwoFactor.secret`/`backupCodes` ŞİFRELİ saklanır (Better Auth
// `symmetricEncrypt`) → `src/tenancy.ts` → `AUTH_SECRET_BEARING_TABLES` üç
// üyeden DÖRDE çıkar (S2'nin işi, bu dosyada DEĞİL).

// `output = "../generated"` iki farklı "generated" konumunun KAYNAĞIDIR:
//   1. packages/db/generated/     — `prisma generate`'in ham TS çıktısı (KÖK, .gitignore'da)
//   2. packages/db/dist/generated/ — (1)'in `tsc -p tsconfig.prisma.json` ile derlenmiş hali
// `pnpm clean` (bkz. package.json → scripts.clean) ikisini de dist/.turbo ile birlikte
// siler — tam temizlik, clean sonrası `generate` yeniden koşulmalıdır.
// `pnpm build` (bkz. package.json → scripts.build) ise SADECE dist/'i temizler ve
// `find dist -mindepth 1 -maxdepth 1 ! -name generated` ile dist/generated'ı KORUR
// (K-B6b) — build, generate'in çıktısını silmeden üstüne derlenmiş kaynağı yazar.
// Bu iki davranış birbirine KARIŞTIRILMASIN.
generator client {
  provider     = "prisma-client"
  output       = "../generated"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

// Prisma 7: `datasource.url` şema dosyasında artık desteklenmiyor. Migrate için
// bağlantı URL'si `prisma.config.ts` → `datasource.url`'de; çalışma zamanında
// istemciye `@prisma/adapter-pg` üzerinden `pg.Pool` adaptörü verilir (R-A4).
datasource db {
  provider = "postgresql"
}

/// Platform seviyesi kiracı (mağaza) kaydı. `tenant_id` taşımaz — bu tablonun
/// kendisi tenant kimliğinin kaynağıdır (V4).
///
/// GÜNCELLEME (ROADMAP v0.0.10, T-012/S2, architect VERİ MODELİ): `themeId`/
/// `themeVersion` EKLENDİ — ikisi de `String?`, uzunluk sınırı YOK (`@db.VarChar`
/// yasak, dosya başı R2). `NOT NULL` BU SÜRÜMDE YOK (CLAUDE.md §10 md 10,
/// expand/contract). DB seviyesinde `DEFAULT` YOK — platform varsayılan teması
/// tek kaynakta, vitrinin kayıt defterinde yaşar (ADR-0002 Karar 5). Eşleşme
/// değişmezi `(theme_id IS NULL) = (theme_version IS NULL)` migration'da ham
/// SQL CHECK kısıtıyla (veya A-A4 ölçümü drift raporluyorsa tek kod yolunda)
/// sağlanır — bkz. `prisma/migrations/<ts>_tenant_theme_selection/migration.sql`.
///
/// GÜNCELLEME (ROADMAP v0.0.21, T-018/S2, ADR-0020 Karar 1 — ÇİFT DOĞRULUK
/// KAYNAĞI KAPATILDI): bu iki kolon bu sürümden itibaren **DEPRECATED AYNA
/// KOLONDUR** — tek yazılabilir doğruluk kaynağı artık `TenantVersionState`
/// (aşağıda). Hiçbir DDL değişikliği YOK (ne `DROP`, ne `SET NOT NULL`, ne
/// `RENAME` — CLAUDE.md §10 md 10 BU SÜRÜMDE TETİKLENMİYOR). Beş fazlı takvim
/// (ADR-0020 Karar 1'de tam metin): v0.0.21 expand (seed iki yere de tek
/// kaynak sabitten yazar) → v0.1.0 kural yazıya geçer → v0.2.0 provisioning
/// `TenantVersionState`'i birincil yazar → v0.0.22/v0.3.0 son okuyucu
/// (`storefront-tenant-read.port.adapter.ts` zinciri) taşınır (tel sözleşmesi
/// değişikliği: additive alan → `Deprecation`/`Sunset` → kaldırma). ⚠ "en
/// erken v0.3.0" ifadesi **mümkün olan en erken andır, BİR TAAHHÜT DEĞİL** —
/// CLAUDE.md §4 ("sonra tüket, iki sürüm sonra sil") ve §10 md 10 kullanımdan
/// kaldırma penceresinin dolmasını şart koşar; son okuyucu v0.3.0'da
/// taşınırsa `DROP COLUMN` (ayrı PR, yıkıcı) **en erken v0.5.0**'dır.
model Tenant {
  id                       String       @id @default(cuid(2))
  slug                     String       @unique
  name                     String
  status                   TenantStatus @default(pending)
  planId                   String?      @map("plan_id")
  primaryDomain            String?      @unique @map("primary_domain")
  themeId                  String?      @map("theme_id")
  themeVersion             String?      @map("theme_version")
  // ROADMAP v0.0.15 (T-016/S1, architect): owner rolü için TOTP 2FA zorunlu
  // kılma anahtarı. Yeni TABLO DEĞİL — tek boolean için ayrı bir
  // `TenantSecurityPolicy` tablosu architect tarafından REDDEDİLDİ
  // (`TENANT_SCOPED_TABLES` 4→5, RLS+FORCE+UNIQUE indeks+prob+yedi zorunlu
  // senaryo, orantısız). NOT NULL + DEFAULT false → mevcut satırlar için
  // YIKICI DEĞİL (CLAUDE.md §10 md 10'un yasakladığı "NOT NULL ekleme" VAR
  // OLAN nullable kolonu SET NOT NULL yapmaktır — bu YENİ bir kolon).
  requireTwoFactorForOwner Boolean      @default(false) @map("require_two_factor_for_owner")
  createdAt                DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                DateTime?    @map("deleted_at") @db.Timestamptz(3)

  memberships   TenantMembership[]
  // ROADMAP v0.0.11 (T-013/S2): `Job.tenant` ilişkisinin ZORUNLU karşı tarafı.
  // Prisma ilişkileri iki taraflıdır — bu satır olmadan `prisma generate`
  // doğrulama hatasıyla durur (emsal: yukarıdaki `memberships`). DDL ÜRETMEZ
  // (FK kolonu `job` tarafındadır).
  jobs          Job[]
  // ROADMAP v0.0.14 (T-014/S1): `AuditLog.tenant` ve `TenantInvitation.tenant`
  // ilişkilerinin ZORUNLU karşı tarafları — `jobs` ile AYNI gerekçe (Prisma
  // ilişkileri iki taraflıdır; bu iki satır olmadan `prisma generate` doğrulama
  // hatasıyla durur ve hata `Tenant` tarafını işaret eder). İkisi de DDL
  // ÜRETMEZ (FK kolonları `audit_log`/`tenant_invitation` tarafındadır).
  auditLogs     AuditLog[]
  invitations   TenantInvitation[]
  // ROADMAP v0.0.21 (T-018/S2): `TenantVersionState.tenant` ve
  // `TenantUpdateHistory.tenant` ilişkilerinin ZORUNLU karşı tarafları —
  // `jobs`/`auditLogs` ile AYNI gerekçe (Prisma ilişkileri iki taraflıdır; bu
  // iki satır olmadan `prisma generate` doğrulama hatasıyla durur). İkisi de
  // DDL ÜRETMEZ (FK kolonları `tenant_version_state`/`tenant_update_history`
  // tarafındadır). `versionState` OPSİYONEL (`?`) — `TenantVersionState` 1:1
  // ilişkidir ve bu sürümde her kiracı için satır YOKTUR (seed sadece demo
  // kiracı için yazar, v0.1.0'da yeni kiracı `pending` doğduğunda satırsız
  // kalır, ADR-0020 Karar 1 takvimi).
  versionState  TenantVersionState?
  updateHistory TenantUpdateHistory[]

  @@map("tenant")
}

/// Platform seviyesi kullanıcı kaydı. Tablo adı `app_user` (R3) — model adı `User`.
///
/// GÜNCELLEME (ROADMAP v0.0.5, T-006/S2, architect A4/A-G1 — birebir ÖLÇÜLDÜ):
/// `emailVerified`/`image` Better Auth'un `User` modelinin BEKLEDİĞİ alanlardır
/// — `@better-auth/cli generate` çıktısıyla (ölçüm: betterAuth@1.7.14 +
/// prismaAdapter, bağlayıcı araç olarak kullanılan `@better-auth/cli@1.4.21`,
/// bkz. Task raporu "A-G1 ÖLÇÜMÜ") BİREBİR karşılaştırıldı, sapma YOK. Yalnızca
/// EKLEME (additive) — Better Auth'un Prisma adaptörü modele PRISMA MODEL
/// ADIYLA erişir (`prisma.user`), `@@map("app_user")`/`@map` ADAPTÖRE GÖRÜNMEZ
/// (A-G2) → `tenant_membership.user_id` FK'si DOKUNULMADAN `app_user.id`'ye
/// bakmaya devam eder (AC3). `sessions`/`accounts` yalnızca Prisma ilişki
/// alanlarıdır — DDL ÜRETMEZLER (Session/Account tarafındaki `@relation` FK
/// kolonunu zaten taşır).
model User {
  id               String     @id @default(cuid(2))
  email            String     @unique
  name             String
  status           UserStatus @default(active)
  emailVerified    Boolean    @default(false) @map("email_verified")
  image            String?
  // ROADMAP v0.0.15 (T-016/S1, architect A-PM2/pm): eklentinin `schema.mjs:3-8`
  // ile BİREBİR (`required:false, defaultValue:false, input:false`). ⭐ BEDAVA
  // yetki tarafı — `app_user`'ın `arkesoft_auth` beklentisi `columnLevel: false`
  // (`src/tenancy.ts:169`) → yetki TABLO seviyesinde, yeni kolon OTOMATİK
  // kapsanır; liste düzenlemesi NE yeniden bootstrap GEREKMEZ (karşılaştır:
  // aşağıdaki `TwoFactor` — YENİ tablo, o S2'de elle eklenir).
  twoFactorEnabled Boolean    @default(false) @map("two_factor_enabled")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz(3)

  memberships TenantMembership[]
  sessions    Session[]
  accounts    Account[]
  // ROADMAP v0.0.15 (T-016/S1): `TwoFactor.user` ilişkisinin ZORUNLU karşı
  // tarafı (`sessions`/`accounts` ile AYNI gerekçe — Prisma ilişkileri iki
  // taraflıdır). DDL ÜRETMEZ (FK kolonu `two_factor` tarafındadır).
  twoFactor   TwoFactor?

  @@map("app_user")
}

/// Better Auth oturum kaydı. PLATFORM SEVİYESİ (`tenant_id` TAŞIMAZ) — oturum
/// KULLANICIYA bağlı, kiracıya değil ("bir hesap → birden fazla mağaza" vaadi
/// bunu zorunlu kılıyor); kiracı üyeliği kontrolü istek ANINDA
/// `tenant_membership` üzerinden yapılır (R2, v0.0.5 architect kararı).
///
/// `session`/`account`/`verification` PostgreSQL'de AYRILMIŞ KELİME DEĞİL →
/// `app_` öneki (R3) GEREKMEZ.
///
/// `ipAddress`: ROADMAP v0.0.15.1 (T-017/S6) ÖNCESİ "TANIMLANIR ama
/// DOLDURULMAZ" idi (`advanced.ipAddress.disableIpTracking: true` →
/// Better Auth'un KENDİ `internal-adapter.mjs`'i HER satıra `''` yazıyordu,
/// ÖLÇÜLDÜ: 2026-11-09, 33336/33336 satır). S6'DAN İTİBAREN
/// `auth-instance.ts`'in `databaseHooks.session.create.before`'u bu alanı
/// `RequestContext.client.ip` İLE EZER (kullanıcı kararı 2026-11-09: IP TAM
/// saklanır, SAHİBİNE tam gösterilir, ASLA loglanmaz) — `disableIpTracking:
/// true` HÂLÂ AYARLI (Better Auth'un KENDİ mekanizmasına GÜVENİLMEMESİ
/// kararı duruyor, K6/KVKK), ama bizim hook'umuz ONUN ürettiği `''`'yi HER
/// `session.create` çağrısında EZER; `client.ip === null` İSE `null` yazılır
/// (`resolveSessionIpAddressForCreateHook`'un gerekçesi — kolon BU YÜZDEN
/// NULLABLE). `userAgent`: `disableIpTracking`'den HER ZAMAN BAĞIMSIZDI
/// (ÖLÇÜLDÜ, `packages/db/src/__tests__/session-metadata-columns.test.ts`,
/// T-017/S3) — header mevcutken GERÇEK değer yazılıyordu/yazılıyor; bu alt
/// görev (S6) BU ALANA DOKUNMADI. Kolonun BUGÜN şemada olması v0.0.15'in
/// yıkıcı migration'a ihtiyaç duymamasını sağlayan bilinçli expand adımıydı.
///
/// MADDE 2 — R-1 KARARI (ADR-0008 taslağı): `token` oturumun TAŞIYICI kimlik
/// bilgisidir — RLS'le korunamaz (asıldan ÖNCE okunur). Koruma derleme
/// zamanında: bkz. `client.ts` → `AUTH_SECRET_BEARING_MODELS`.
model Session {
  id        String   @id @default(cuid(2))
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/// Better Auth kimlik bilgisi kaydı (e-posta/şifre + ileride sosyal sağlayıcı
/// bağlantıları). PLATFORM SEVİYESİ — kimlik bilgisi (parola hash'i) HESABA
/// aittir, kiracıya değil.
///
/// `(provider_id, account_id)` BİLEŞİK BENZERSİZLİK kısıtı: aynı sağlayıcı +
/// sağlayıcı hesap kimliği ikinci bir satıra bağlanamaz (architect VERİ
/// MODELİ, indeks listesi).
///
/// MADDE 2 — R-1 KARARI: `password` parola HASH'idir — RLS'le korunamaz
/// (giriş anında, asıldan ÖNCE okunur zorundadır). Koruma derleme zamanında:
/// bkz. `client.ts` → `AUTH_SECRET_BEARING_MODELS`.
model Account {
  id                    String    @id @default(cuid(2))
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

/// Better Auth doğrulama/sıfırlama belirteç kaydı (e-posta doğrulama, şifre
/// sıfırlama). PLATFORM SEVİYESİ — belirteç e-posta KİMLİĞİNE bağlıdır, giriş
/// anında kiracı bilgisi henüz yok (R1).
///
/// MADDE 2 — R-1 KARARI: `value` HAM belirteçtir — RLS'le korunamaz. Koruma
/// derleme zamanında: bkz. `client.ts` → `AUTH_SECRET_BEARING_MODELS`.
///
/// `User` ile İLİŞKİSİ YOK (Better Auth `identifier`'ı serbest metin olarak
/// tutar, FK kurmaz) — bu tablo model olarak `User`'dan bağımsızdır.
model Verification {
  id         String   @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

/// Kullanıcının TOTP ikinci faktör kaydı (ROADMAP v0.0.15, T-016/S1, architect
/// A-PM2 — PLATFORM SEVİYESİ, `tenant_id` TAŞIMAZ). Alanlar Better Auth'un
/// `two-factor` eklentisinin `twoFactor` modeliyle BİREBİR eşleştirildi —
/// `better-auth/dist/plugins/two-factor/schema.mjs:9-50`, kaynak dosya
/// AÇILIP DOĞRULANDI. Gerekçe `Session`'ınkiyle (yukarıda) BİREBİR: ikinci
/// faktör KULLANICIYA aittir, kiracıya değil ("bir hesap → birden fazla
/// mağaza", v0.0.5 architect kararı). `tenant_id` eklemek aynı kullanıcıya
/// kiracı başına AYRI bir TOTP sırrı anlamına gelirdi; eklentinin
/// `findOne({where:[{field:'userId'}]})` erişim deseni (`index.mjs:126-132`)
/// bunu YAPISAL olarak desteklemiyor.
///
/// ⭐ Sonuç: `TENANT_SCOPED_TABLES` DÖRTTE KALIR (bu model BEŞİNCİ üye
/// DEĞİL) — yeni izolasyon probu YAZILMAZ, prob tamlığı kapısı KIRILMAZ,
/// RLS politikası YAZILMAZ.
///
/// ⚠ `secret`/`backupCodes` ŞİFRELİ saklanır (Better Auth'un
/// `symmetricEncrypt`'i, anahtar `BETTER_AUTH_SECRET`) — HAM değer DEĞİL.
/// İkisi de bu yüzden `src/tenancy.ts` → `AUTH_SECRET_BEARING_TABLES`'a
/// EKLENİR (üç üyeden DÖRDE — `account`/`session`/`verification` + bu tablo;
/// S2'nin işi, bu şema dosyasında DEĞİL) — eklenmezse `arkesoft_auth` bu
/// tabloyu okuyamaz (çalışma zamanı arızası).
///
/// `verified` varsayılanı `false` (ROADMAP v0.0.15, T-016, FIX turu 1,
/// `security` [low] F3 bulgusu — bkz. `prisma/migrations/
/// 20261109054748_two_factor_verified_default_false/migration.sql`).
/// Better Auth eklentisinin KENDİ şema bildirimi `defaultValue: true`'dur
/// AMA çalışma zamanında `enable` ucu `verified`i HER ZAMAN AÇIKÇA yazar
/// (`index.mjs:152`, bizim yapılandırmamızda `false`) — bugün tek yazıcı bu
/// yüzden DB varsayılanını hiç GÖRMEZ, davranışsal maliyet SIFIR. `false`
/// seçildi (eklentinin `true`'sundan BİLEREK SAPILDI) ÇÜNKÜ DB varsayılanı
/// `verified`i AÇIKÇA göndermeyen GELECEKTEKİ bir yazıcı için fail-closed
/// davranmalı — "ikinci faktör VARLIĞI = doğrulanmış" kabul eden her kod
/// yolunun varsayılan olarak DOĞRULANMAMIŞ bir kaydı KABUL ETMEMESİ gerekir.
/// `20261106073351_two_factor_and_security_policy/migration.sql` (DONMUŞ,
/// checksum `_prisma_migrations` ile elle senkronlanmış) DEĞİŞTİRİLMEDİ —
/// bu, O migration'ın `DEFAULT true`'sunu SONRADAN `SET DEFAULT false` ile
/// tersleyen AYRI, tek adımlı, yıkıcı OLMAYAN bir migration'dır (mevcut
/// satırları ETKİLEMEZ, `NOT NULL` eklemez, `DROP COLUMN` yapmaz).
///
/// İNDEKS KARARI — ikisi BİLİNÇLİ OLARAK YOK:
///   - `userId` `@unique` → ayrı bir `@@index` GEREKMEZ: tekil kısıt zaten
///     bir B-tree indekstir VE kullanıcı↔TOTP 1:1 ilişkisini veritabanı
///     seviyesinde ZORLAR (eklentinin `enable` ucunun findOne-sonra-create
///     YARIŞINI kapatır).
///   - `secret` üzerinde indeks YOK — eklentinin `schema.mjs:14`'teki
///     `index: true`'su Better Auth'un KENDİ migration üreticisi İÇİNDİR
///     (biz Prisma şemasını ELLE yazıyoruz); şifreli bir kolon hiçbir
///     sorguda yüklem OLMADIĞI için indeks SAF KAYIPTIR (`TenantInvitation`
///     emsali, yukarıda: "gereksiz indeks yazma yüküne maliyettir").
///   - `lockedUntil` üzerinde de indeks YOK — hep `id` ile birlikte okunur/
///     güncellenir, ayrı TARANMAZ.
///   - `(tenant_id, …)` bileşik indeks GEREKMEZ (platform tablosu).
///
/// `onDelete: Cascade` — `Session`/`Account`'un BİREBİR aynı kararı: kullanıcı
/// silindiğinde ikinci faktör kaydı YETİM KALAMAZ.
model TwoFactor {
  id                      String    @id @default(cuid(2))
  userId                  String    @unique @map("user_id")
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor")
}

/// Tenant'a bağlı tablo — `TENANT_SCOPED_TABLES`'ın BİRİNCİ üyesi. Taksonominin
/// kanonik listesi `src/tenancy.ts`'tedir ve v0.0.14'ten itibaren DÖRT üyelidir
/// (`tenant_membership`, `job`, `audit_log`, `tenant_invitation`).
/// RLS zemini: `tenant_id` kolonu tam olarak bu adla, `text`, NOT NULL ve
/// `(tenant_id, user_id)` bileşik benzersizlik kısıtının öncü kolonu; politika
/// `<ts>_rls_tenant_isolation/migration.sql`'de.
/// Soft delete YOK — üyelik kaldırma hard delete'tir (ADR-0003 madde 3).
model TenantMembership {
  id        String     @id @default(cuid(2))
  tenantId  String     @map("tenant_id")
  userId    String     @map("user_id")
  role      TenantRole
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // ⚠ KURAL (ROADMAP v0.0.14, T-014/S1, architect K-A12 — R-A10'un BU SÜRÜMDEKİ
  // karşılanma biçimi): aşağıdaki `onDelete: Cascade` BİLEREK DEĞİŞTİRİLMEDİ.
  // INV-OWNER ("her kiracının tam olarak bir `owner`'ı var") KODDA zorlanır
  // (`apps/api`, CAS deseni) → `member.remove`/`member.updateRole` yoluyla
  // sahipsiz kiracı üretmek İMKÂNSIZ. Sahipsiz kiracı üretebilecek TEK yol
  // `app_user` hard delete'idir ve ÜRETİMDE O YOL YOKTUR (ölçüldü: kullanıcı
  // hard delete'i yalnızca `packages/db/src/__tests__/**` içinde; kimlik
  // doğrulama yüzeyinde kullanıcı silme ucu yok). Bu kuralın GÜÇLÜ (veritabanı)
  // biçimi — FK aksiyonunu `Restrict`'e çevirmek — v0.0.19'a (hesap silme/GDPR
  // yüzeyi) SIRALANDI, düşürülmedi: bugün çevirmek migration'da kısıt kaldırma
  // ifadesi gerektirir, migration linter'ının yıkıcı-ifade kuralı kırmızıya
  // döner ve kuralı gevşetme baskısı doğar (CLAUDE.md §10 md 6). ⚠ Borç satırı
  // KAPANMADI, TAŞINDI.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_membership")
}

/// Kiracıya bağlı arka plan işi kaydı (ROADMAP v0.0.11, T-013/S2, architect K3
/// birebir). `TENANT_SCOPED_TABLES`'ın İKİNCİ üyesi — ⚠ dizinin KENDİSİ
/// v0.0.14'ten (T-014/S1) itibaren DÖRT üyelidir (`audit_log` ve
/// `tenant_invitation` eklendi); bu sıra numarası eklenme sırasıdır, dizinin
/// uzunluğu DEĞİL. `tenant_membership`'in
/// taşıdığı tüm değişmezleri (CLAUDE.md §7 md 1-3) taşır: `tenant_id` `text`
/// NOT NULL, RLS `ENABLE`+`FORCE`, kanonik `USING`/`WITH CHECK` politikası
/// (bkz. `<ts>_job_table/migration.sql`) ve `tenant_id` öncü bileşik indeksler.
///
/// `@@unique([tenantId, id])` DEKORATİF DEĞİL, ZORUNLU (architect R-A1):
/// `Job`'un doğal bileşik benzersizliği YOKTUR (`tenant_membership` bunu
/// `(tenant_id, user_id)` ile doğal olarak karşılıyordu), ama CLAUDE.md §7 md 3
/// her kiracı tablosundan `tenant_id` öncü BİLEŞİK indeks istiyor ve migration
/// linter'ı (`__tests__/helpers/migration-set.ts`,
/// `MISSING_TENANT_ID_LEADING_UNIQUE_INDEX`) bunu mekanik olarak zorluyor.
/// Fonksiyonel gerekçe: RLS her sorguya `tenant_id = current_setting(...)`
/// yüklemini EKLER → `job.get`'in fiili yüklemi zaten `(tenant_id, id)`'dir,
/// yani bu o sorgunun İDEAL indeksidir.
///
/// `status` Prisma `enum`'u (String + Zod union DEĞİL): geçersiz durum DB
/// seviyesinde mekanik olarak imkânsız; Prisma'nın ürettiği enum tam literal
/// union verdiği için §4'ün "exhaustive switch + assertNever" şartıyla
/// ÇATIŞMAZ. `cancelled` YOK (`job.cancel` v0.0.11 kapsamı dışında) —
/// sonradan eklenmesi `ALTER TYPE … ADD VALUE` ile additive'dir.
///
/// `payload`/`error` → `Json` (Prisma+PG varsayılanı `jsonb`; `@db.Json`
/// YAZILMAZ). İkisi de okunurken Zod ile parse edilir (§4) — şemaları
/// `apps/api` tarafında yaşar, `payload` tele HİÇ ÇIKMAZ. `error`
/// `@arkesoft/errors` → `toErrorBody()`'nin birebir çıktısıdır; `AppError.context`
/// o gövdeye ASLA girmez, dolayısıyla bu kolon sır/PII TAŞIMAZ.
///
/// Soft delete YOK — iş kaydı olgusal bir denetim izidir; silme/retention
/// politikası v0.0.17 kapsamındadır.
model Job {
  id          String    @id @default(cuid(2))
  tenantId    String    @map("tenant_id")
  type        String
  status      JobStatus @default(queued)
  progress    Int       @default(0)
  payload     Json
  error       Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("job")
}

/// Kiracıya bağlı denetim kaydı (ROADMAP v0.0.14, T-014/S1, architect K-A1
/// birebir). `TENANT_SCOPED_TABLES`'ın ÜÇÜNCÜ üyesi — `tenant_membership` ve
/// `job`'un taşıdığı tüm değişmezleri (CLAUDE.md §7 md 1-3) taşır: `tenant_id`
/// `text` NOT NULL, RLS `ENABLE`+`FORCE`, kanonik `USING`/`WITH CHECK`
/// politikası (bkz. `<ts>_rbac_audit_log_and_invitation/migration.sql`) ve
/// `tenant_id` öncü bileşik indeksler.
///
/// APPEND-ONLY. `updatedAt` BİLEREK YOK: satır yazıldıktan sonra DEĞİŞMEZ,
/// bir UPDATE yolu yoktur. `@updatedAt` eklemek "bu satır güncellenebilir"
/// anlamı taşır ve yanlış bir sözleşme beyan eder. Soft delete de YOK —
/// denetim izinin silinmesi bir saklama (retention) politikası kararıdır,
/// v0.0.17 kapsamındadır.
///
/// ⚠ `actorUserId` için YABANCI ANAHTAR YOKTUR ve bu bilinçli: denetim izi
/// aktörden UZUN YAŞAR. `Cascade` olsaydı bir kullanıcı silindiğinde onun
/// yaptığı her yetki değişikliğinin kaydı da giderdi (denetim izinin varlık
/// sebebini yok eder); `Restrict` olsaydı kullanıcı silmek denetim kaydı
/// yüzünden kilitlenirdi. Kolon bu yüzden ilişkisiz bir `text`'tir —
/// "o anda aktör kimdi" olgusunu saklar, canlı bir referans TUTMAZ.
///
/// `action` Prisma `enum`'u (`Job.status` emsali): geçersiz değer veritabanı
/// seviyesinde mekanik olarak imkânsız. ⚠ `revoked` gibi TÜKETİCİSİ OLMAYAN bir
/// değer BİLEREK YOKTUR ("ölü sözlük = ölü iznin kardeşi"); değer EKLEMEK
/// `ALTER TYPE … ADD VALUE` ile additive'dir. Bu enum TELE HİÇ ÇIKMAZ
/// (denetim kaydını okuyan bir prosedür bu sürümde yok) → `TenantStatus`/
/// `TenantRole` için gereken tele-enum parite pini BU enum için GEREKMEZ.
///
/// `subject` TEK kolondur ve anlamı KAPALI ve YAZILIDIR: `member_invited` →
/// `invitationId`; diğer üç değer → `userId`. Zincir `diff.invitationId`
/// üzerinden kurulur. ⚠ E-POSTA `audit_log`'a HİÇ GİRMEZ — beklemedeki adres
/// `tenant_invitation.email`'de yaşar.
///
/// `diff` → `Json` (Prisma+PG varsayılanı `jsonb`; `@db.Json` YAZILMAZ).
/// Okunurken Zod ile parse edilir (CLAUDE.md §4) ve YAZILIRKEN de bir Zod
/// kapısından geçer — şemalar `apps/api` tarafında yaşar (eylem başına ayrı
/// şema; fazla anahtar DÜŞÜRÜLÜR). Bu kolon bu yüzden sır/PII TAŞIMAZ.
///
/// `ip`/`userAgent` kişisel veri sınıfındadır AMA denetim kaydının VARLIK
/// SEBEBİDİR — CLAUDE.md §4'ün "asla loglanmaz" listesinde yoktur: SAKLANIR,
/// LOGLANMAZ.
///
/// `@@unique([tenantId, id])` DEKORATİF DEĞİL, ZORUNLU (`Job`'un birebir aynı
/// durumu): bu tablonun doğal bir bileşik benzersizliği YOKTUR (aynı aktör aynı
/// özneye aynı eylemi iki kez uygulayabilir — denetim kaydı bunu İKİ SATIR
/// olarak tutmak zorundadır), ama CLAUDE.md §7 md 3 her kiracı tablosundan
/// `tenant_id` öncü BİLEŞİK indeks istiyor ve migration linter'ı
/// (`__tests__/helpers/migration-set.ts`,
/// `MISSING_TENANT_ID_LEADING_UNIQUE_INDEX`) bunu mekanik olarak zorluyor.
model AuditLog {
  id          String      @id @default(cuid(2))
  tenantId    String      @map("tenant_id")
  actorUserId String      @map("actor_user_id")
  action      AuditAction
  subject     String
  diff        Json
  ip          String?
  userAgent   String?     @map("user_agent")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_log")
}

/// Kiracıya bağlı, HENÜZ KABUL EDİLMEMİŞ üyelik daveti (ROADMAP v0.0.14,
/// T-014/S1, architect K-A1 + K-A0). `TENANT_SCOPED_TABLES`'ın DÖRDÜNCÜ üyesi.
///
/// NEDEN AYRI BİR TABLO: davet kabul edilirken kullanıcı HENÜZ VAR OLMAYABİLİR
/// (`TenantMembership.userId` NOT NULL + `app_user`'a FK) → üyeliği "beklemede"
/// olarak önceden yazmak imkânsız. Better Auth'un `verification` tablosu da
/// kullanılamaz (sır taşıyan üç tablodan biri; erişimi derleme zamanında
/// `AuthModule`'e daraltılmış — bkz. `src/client.ts`).
///
/// ⚠ HAM BELİRTEÇ SAKLANMAZ — yalnızca `tokenHash` (sha256 özeti). İki sonucu
/// var ve ikisi de bağlayıcı: (1) bu model `src/client.ts`'in
/// `AUTH_SECRET_BEARING_MODELS` listesine GİRMEZ (o liste ÜÇ üyede kalır) ve
/// (2) kimlik bilgisi taşıyan kolonların sayısını büyütmediği için v0.0.14.1'in
/// (kimlik doğrulama rolü ayrımı) kapsamını BÜYÜTMEZ.
///
/// `email` KÜÇÜK HARFE NORMALİZE EDİLEREK yazılır ve karşılaştırılır. Bu bir
/// veritabanı kısıtı DEĞİL, yazma/okuma yolunun sözleşmesidir (uygulaması
/// `apps/api`, T-014/S4) — `@@unique([tenantId, email])` ancak normalize
/// edilmiş değerlerle anlamlıdır: aksi halde `A@x.com` ve `a@x.com` İKİ ayrı
/// bekleyen davet üretir ve "zaten davet edilmiş mi" kontrolü atlanır.
///
/// SOFT DELETE YOK: davet kabul edildiğinde satır SİLİNİR (belirteç tek
/// kullanımlık; ikinci kabul denemesi "geçersiz davet" alır). `updatedAt` VAR
/// — tekrar davet aynı satırı günceller (`upsert`), yani bu tablo `AuditLog`'un
/// aksine GERÇEKTEN güncellenir.
///
/// ⚠ İLİŞKİ/FK KARARI (T-014/S1, `db` ajanının kararı — architect K-A1 bu satırı
/// BELİRTMEMİŞTİ, `po` R-PO6 ile işaretledi):
///   - `tenant` → `onDelete: Cascade`. Gerekçe MEKANİK: kiracı silindiğinde
///     bekleyen davetler YETİM kalırsa izolasyon süitinin kiracı temizliği
///     (`cleanupTenant`) satır bırakır ve çapraz kiracı okuma senaryosu
///     SIZDIRIR. `TenantMembership`/`Job`'un birebir aynı kararı.
///   - `invitedByUserId` → FK YOK. Gerekçe `AuditLog.actorUserId` ile AYNI:
///     "daveti kim gönderdi" bir OLGUDUR; davet eden kullanıcının silinmesi ne
///     bekleyen daveti geçersiz kılmalı (Cascade) ne de kullanıcı silmeyi
///     kilitlemeli (Restrict). Kolon ilişkisiz bir `text`'tir.
///
/// İNDEKS GEREKÇESİ (yalnızca iki, üçüncüsü BİLEREK yok):
///   - `@@unique([tenantId, email])` — DOĞAL benzersizlik. Bu yüzden `Job`/
///     `AuditLog`'un ihtiyaç duyduğu yapay `@@unique([tenantId, id])`
///     GEREKMEZ (migration linter'ının `tenant_id` öncü UNIQUE INDEX şartı
///     bu kısıtla zaten karşılanıyor).
///   - `@@unique([tenantId, tokenHash])` — kabul sorgusunun İDEAL indeksi
///     (RLS her sorguya `tenant_id = …` yüklemini zaten EKLER, dolayısıyla
///     fiili yüklem `(tenant_id, token_hash)`'tir).
///   - `expiresAt` üzerinde indeks YOK: süresi geçmiş davet SORGULANMAZ,
///     yalnızca tek satır okunurken kontrol edilir. Gereksiz indeks yazma
///     yüküne maliyettir — bu tablo davet başına yazılır, taranmaz.
model TenantInvitation {
  id              String     @id @default(cuid(2))
  tenantId        String     @map("tenant_id")
  email           String
  role            TenantRole
  tokenHash       String     @map("token_hash")
  invitedByUserId String     @map("invited_by_user_id")
  expiresAt       DateTime   @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@unique([tenantId, tokenHash])
  @@map("tenant_invitation")
}

/// Platform seviyesi, kesilmiş bir platform sürümünün kaydı (ROADMAP v0.0.21,
/// T-018/S2, architect VERİ MODELİ + ADR-0020). `PLATFORM_LEVEL_TABLES`'ın
/// YEDİNCİ üyesi — bir platform sürümü kiracıya değil, platformun KENDİSİNE
/// aittir; §4'ün kademeli dağıtımı bile kiracıyı sürüme atar, sürümü kiracıya
/// değil (ADR-0020 Karar — sınıflandırma ekseni: "olgu KİME aittir").
///
/// ⚠ `updatedAt` BİLEREK YOK (`AuditLog` emsali, güçlendirilmiş): kesilmiş bir
/// sürüm kaydı DEĞİŞMEZ; `notes`'u sonradan düzenlemek sürüm geçmişini yeniden
/// yazmaktır. `notes` NULLABLE — V5 disiplini ("tarihsel sürümler GERİYE
/// DOLDURULMAZ", uydurmak kaydı YALANLA başlatır); bu sürümde yazılan TEK
/// satırın (`stable`, seed) notu olabilir ama gelecekteki her satırın notu
/// ZORUNLU değildir.
///
/// `channel` İKİ değer taşır (`stable`, `canary`) — Sürüm Politikası §4'ün
/// tanımladığı ÜÇÜNCÜ değer (`dev`) BİLEREK YOK ("ölü sözlük, ölü iznin
/// kardeşidir"; `dev`'in bu sürümde tüketicisi yok). Değer EKLEMEK
/// `ALTER TYPE … ADD VALUE` ile additive'dir (vade: v0.16.0).
///
/// `@@unique([version, channel])`: aynı sürüm numarası farklı kanallarda AYRI
/// satır olabilir (bir sürüm önce `canary`, sonra `stable` kesilebilir) ama
/// AYNI kanalda İKİNCİ kez kesilemez. `@@index([channel, releasedAt desc])`:
/// "bu kanalın en son sürümü" sorgusunun İDEAL indeksi (N-2 penceresi ve
/// güncelleme kontrolü bu yüklemle okur, v0.16.0).
model PlatformRelease {
  id            String         @id @default(cuid(2))
  version       String
  channel       ReleaseChannel
  releasedAt    DateTime       @map("released_at") @db.Timestamptz(3)
  notes         String?
  minApiVersion String         @map("min_api_version")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([version, channel])
  @@index([channel, releasedAt(sort: Desc)])
  @@map("platform_release")
}

/// Platform seviyesi tema kaydı (ROADMAP v0.0.21, T-018/S2, ADR-0020 Karar 3).
/// `PLATFORM_LEVEL_TABLES`'ın SEKİZİNCİ üyesi.
///
/// ⚠⚠ `id` DOĞAL ANAHTARDIR (`String @id`, `@default(cuid(2))` YOK) — ADR-0003
/// R2 konvansiyonundan BİLİNÇLİ bir sapma (ADR-0020 Karar 3'te tam gerekçe).
/// Değeri temanın manifest id'sidir (bugün `'modern'`) — ADR-0002 Karar 3 tema
/// kimliğini zaten `"{id}@{version}"` biçiminde dondurdu ve `Tenant.themeId`
/// BUGÜN `'modern'` taşıyor; vekil (cuid2) bir anahtar seçmek bu kolonu
/// çözümlenemez hâle getirir ve v0.0.21 AC-11 sapma testini iki farklı türde
/// değeri karşılaştırmaya zorlardı.
///
/// ⚠⚠ `slug` OLUŞTURULMAZ — ROADMAP'in alan listesinden bilinçli bir daraltma
/// (VARSAYIM A-T18-7, Orkestratör onayı): `slug`, `id`'nin bayt-birebir ikinci
/// kopyası olurdu — bu modelin VARLIK SEBEBİYLE (çift kopya sorunu, ADR-0020
/// Karar 1) doğrudan çelişir.
model Theme {
  id        String      @id
  name      String
  status    ThemeStatus @default(active)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  releases ThemeRelease[]

  @@map("theme")
}

/// Platform seviyesi, bir temanın yayınlanmış/taslak sürüm kaydı (ROADMAP
/// v0.0.21, T-018/S2, architect VERİ MODELİ). `PLATFORM_LEVEL_TABLES`'ın
/// DOKUZUNCU üyesi.
///
/// `sdkRange` theme-sdk aralığıdır (bugün `'>=0.1.0 <1.0.0'` formatında,
/// `packages/theme-sdk/src/manifest/manifest.ts:72-84`'ün kapalı grameriyle
/// doğrulanır — doğrulama `apps/api`/`theme-sdk` tarafında, bu kolon seviyesinde
/// DEĞİL). `changelog` NULLABLE — bir `draft` sürümün changelog'u henüz
/// yazılmamış olabilir.
///
/// **CHECK #1** (`theme_release_published_at_pairing_check`, elle migration
/// SQL'i, `tenant_theme_selection_pairing_check` emsali): `(status = 'draft')
/// = (published_at IS NULL)` — `draft` bir sürümün `publishedAt`'i VARDIR
/// anlamına gelen yanlış bir durumu veritabanı seviyesinde İMKÂNSIZ kılar.
///
/// ⚠ ADR-0002 Karar 8 (bağlayıcı): `modern@0.1.0` seed'de `status='draft'`,
/// `publishedAt=NULL` yazılır — yayın koşulunun iki bileşeni (görsel regresyon
/// v0.0.19, Lighthouse v0.1.x+) bu sürümde karşılanamaz; `published` yazmak
/// kaydı YALANLA başlatırdı.
///
/// `@@unique([themeId, version])`: bir tema aynı sürüm numarasını İKİNCİ kez
/// yayınlayamaz. `@@index([themeId, status, publishedAt desc])`: "bu temanın
/// yayınlanmış en son sürümü" sorgusunun İDEAL indeksi (provisioning, v0.2.0).
///
/// ⚠⚠ `TenantVersionState.themeId`'ye BİLEŞİK YABANCI ANAHTAR YAZILMAZ
/// (ADR-0020 Karar 3 — üç gerekçe: `Tenant.themeId`'nin bugün FK'si yok,
/// asimetri sapma testini ifade edilemez kılar; ADR-0002 Karar 5 kodda var
/// olup `Theme` satırı henüz yazılmamış bir temayı meşru ara durum sayar; FK
/// izolasyon probunun `cleanupTenant` sözleşmesini platform fixture
/// sızıntısına açardı). Referans bütünlüğü yazma yolunda (v0.2.0) zorlanır.
model ThemeRelease {
  id          String             @id @default(cuid(2))
  themeId     String             @map("theme_id")
  version     String
  sdkRange    String             @map("sdk_range")
  changelog   String?
  status      ThemeReleaseStatus @default(draft)
  publishedAt DateTime?          @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([themeId, version])
  @@index([themeId, status, publishedAt(sort: Desc)])
  @@map("theme_release")
}

/// Kiracıya bağlı, kiracının BUGÜNKÜ sürüm bileşiminin TEK yazılabilir
/// doğruluk kaynağı (ROADMAP v0.0.21, T-018/S2, ADR-0020 Karar 1).
/// `TENANT_SCOPED_TABLES`'ın BEŞİNCİ üyesi — `tenant_membership`/`job`/
/// `audit_log`/`tenant_invitation`'ın taşıdığı tüm değişmezleri (CLAUDE.md §7
/// md 1-3) taşır: `tenant_id` `text` NOT NULL, RLS `ENABLE`+`FORCE`, kanonik
/// `USING`/`WITH CHECK` politikası (bkz. `<ts>_version_registry/migration.sql`,
/// `20261104083007_rbac_audit_log_and_invitation/migration.sql:122-135`'ten
/// BAYT-BİREBİR kopyalandı) ve `tenant_id` öncü bileşik indeksler.
///
/// Dört sürüm alanı (`platformVersion`/`themeId`/`themeVersion`/`apiVersion`)
/// NOT NULL — Arkesoft'un rakiplerden ayrıştığı iddianın veri temeli: "kiracı
/// hangi sürüm bileşiminde?" sorusunun TEK satırda yaşayan TEK cevabı.
/// `previousState` → `Json?` (NULLABLE — ilk kurulumun önceki hâli YOK, A-T18
/// varsayım teyidi); geri alma (rollback) için anlık görüntü, Sürüm Politikası
/// §5.1-5.2'nin geri yazacağı dört alanın TAMAMINI taşır (v0.0.21 AC-6
/// yeterlilik pini). Okunurken Zod ile parse edilir (CLAUDE.md §4); şema
/// `apps/api` tarafında yaşar, bu kolon bu yüzden sır/PII TAŞIMAZ.
///
/// ⚠ `lastUpdatedAt` ≠ `updatedAt`: BİRİNCİSİ sürüm GEÇİŞİNİN iş zaman damgası
/// (yazma yolu AÇIKÇA yazar, `@updatedAt` DEĞİL), İKİNCİSİ Prisma'nın satır-
/// dokunma damgasıdır. Gelecekte alakasız bir kolon düzeltmesi `updatedAt`'i
/// kaydırır ama `lastUpdatedAt`'i KAYDIRMAMALIDIR. ⚠⚠ TRIGGER YOK (ADR-0020
/// Karar 4, `schema.prisma:13-14`'ün yürürlükteki kuralı) — ikisi de UYGULAMA
/// KATMANINDA yazılır.
///
/// ⚠⚠ `tenantId @unique` (GERÇEK 1:1 değişmezi) **VE** `@@unique([tenantId,
/// id])` (migration linter'ının `tenant_id` öncü bileşik indeks şartı,
/// `__tests__/helpers/migration-set.ts` `MISSING_TENANT_ID_LEADING_UNIQUE_INDEX`)
/// — İKİSİ BİRLİKTE, kasıtlı maliyet (ADR-0020 Sonuçlar, `Job`/`AuditLog`
/// emsali: ikincisi birincinin ÖNEKİ, artık, ama tablo kiracı başına BİR satır
/// taşır). Ek `@@index` YOK — RLS her sorguya `tenant_id = …` yüklemini zaten
/// ekler ve `tenantId @unique` zaten o yüklemin ideal indeksidir.
///
/// `TenantVersionState.themeId`'ye `ThemeRelease`'den BİLEŞİK FK YOKTUR
/// (ADR-0020 Karar 3 — bkz. `ThemeRelease` model doc'u).
model TenantVersionState {
  id              String   @id @default(cuid(2))
  tenantId        String   @unique @map("tenant_id")
  platformVersion String   @map("platform_version")
  themeId         String   @map("theme_id")
  themeVersion    String   @map("theme_version")
  apiVersion      String   @map("api_version")
  lastUpdatedAt   DateTime @map("last_updated_at") @db.Timestamptz(3)
  previousState   Json?    @map("previous_state")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@map("tenant_version_state")
}

/// Kiracıya bağlı sürüm güncelleme/geri alma denetim kaydı (ROADMAP v0.0.21,
/// T-018/S2, architect VERİ MODELİ). `TENANT_SCOPED_TABLES`'ın ALTINCI üyesi
/// — yukarıdaki `TenantVersionState`'in taşıdığı tüm değişmezleri (CLAUDE.md
/// §7 md 1-3) taşır: `tenant_id` `text` NOT NULL, RLS `ENABLE`+`FORCE`,
/// kanonik `USING`/`WITH CHECK` politikası ve `tenant_id` öncü bileşik
/// indeksler.
///
/// `fromState` → `Json?` NULLABLE (ilk kurulumun önceki hâli YOK — A-T18
/// varsayım DÜZELTMESİ, teyit), `toState` → `Json` NOT NULL. İkisi de anlık
/// görüntü biçimindedir (bkz. `TenantVersionState.previousState`).
///
/// ⚠ `triggeredBy` SERBEST METİN DEĞİLDİR → `UpdateTrigger` enum + AYRI
/// `triggeredByUserId String?` (FK YOK, `AuditLog.actorUserId` emsali — "o
/// anda tetikleyen kimdi" bir OLGUDUR, canlı bir referans TUTMAZ).
/// `platform_auto` ile kullanıcı tetiklemesi FARKLI TÜRDE olgulardır (§4
/// "discriminated union; boolean/dize bayrak yığını kurma" yasağı). ⚠ İKİNCİ
/// bir CHECK (`triggered_by` ↔ `triggered_by_user_id` eşleşmesi) YAZILMAZ —
/// CHECK bugünkü bir YAZICININ ihlal edebileceği değişmezi korur, bu sürümde
/// HİÇ yazıcı yok; erken CHECK tüketicisi olmayan bir kısıt olurdu.
///
/// `status` → `UpdateStatus` enum (`running`/`completed`/`failed`). ⚠⚠
/// `rolled_back` değeri BİLEREK YOKTUR (`AuditAction.revoked` emsali, "ölü
/// sözlük, ölü iznin kardeşidir") — geri alma KENDİ SATIRIDIR, `fromState`/
/// `toState`'in yönü onu zaten ayırt eder. Değer EKLEMEK additive'dir (vade
/// v0.16.0).
///
/// **CHECK #2** (`tenant_update_history_finished_after_started_check`, elle
/// migration SQL'i): `finished_at IS NULL OR finished_at >= started_at` —
/// bitiş zamanı başlangıçtan ÖNCE olan bir satırı veritabanı seviyesinde
/// İMKÂNSIZ kılar.
///
/// `error` → `Json?`, `Job.error`'ın BİREBİR SÖZLEŞME kopyası: tam olarak
/// `@arkesoft/errors` → `toErrorBody()`'nin çıktısıdır; `AppError.context` o
/// gövdeye ASLA girmez, dolayısıyla bu kolon sır/PII TAŞIMAZ (CLAUDE.md §4'ün
/// "asla loglanmaz" listesinin veritabanı karşılığı).
///
/// `@@unique([tenantId, id])` DEKORATİF DEĞİL, ZORUNLU (`Job`/`AuditLog`'un
/// birebir aynı durumu — doğal bileşik benzersizlik YOKTUR, migration
/// linter'ının `tenant_id` öncü bileşik indeks şartı mekanik olarak zorluyor).
/// `@@index([tenantId, startedAt desc])`: "bu kiracının güncelleme geçmişi"
/// sorgusunun İDEAL indeksi (RLS zaten `tenant_id = …` yüklemini ekler).
model TenantUpdateHistory {
  id                String        @id @default(cuid(2))
  tenantId          String        @map("tenant_id")
  fromState         Json?         @map("from_state")
  toState           Json          @map("to_state")
  triggeredBy       UpdateTrigger @map("triggered_by")
  triggeredByUserId String?       @map("triggered_by_user_id")
  status            UpdateStatus  @default(running)
  startedAt         DateTime      @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime?     @map("finished_at") @db.Timestamptz(3)
  error             Json?
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, startedAt(sort: Desc)])
  @@map("tenant_update_history")
}

/// Kiracı durumu. `deleted` değeri YOKTUR (A-V8) — silinmişliğin tek doğruluk
/// kaynağı `Tenant.deletedAt`'tir.
enum TenantStatus {
  pending
  provisioning
  active
  suspended

  @@map("tenant_status")
}

/// Kullanıcı durumu. Abonelik/ödeme durumları bu alana karışmaz (V3).
enum UserStatus {
  active
  suspended

  @@map("user_status")
}

/// Üyelik rolü. `platform_admin` YOKTUR — platform yetkisi, üyelik değildir.
enum TenantRole {
  owner
  admin
  staff
  support
  readonly

  @@map("tenant_role")
}

/// Arka plan işi durumu (ROADMAP v0.0.11, T-013/S2). Dört terminal olmayan/
/// terminal durum: `queued` (kuyrukta) → `running` (bir worker aldı) →
/// `completed` | `failed`. `cancelled` BİLEREK YOK — `job.cancel` bu sürümün
/// kapsamı dışında; değer EKLEMEK additive bir migration'dır, ÇIKARMAK
/// kolon silmekle aynı iki-sürüm kuralına tabidir.
enum JobStatus {
  queued
  running
  completed
  failed

  @@map("job_status")
}

/// Denetim kaydı eylemi (ROADMAP v0.0.14, T-014/S1, architect K-A1). Bu sürümün
/// kapsamındaki TEK olay sınıfı "yetki değişikliği"dir ve dört değerin DÖRDÜ DE
/// tüketilir (davet et → kabul → rol değiştir → çıkar).
///
/// ⚠ `revoked` (daveti geri çekme) gibi TÜKETİCİSİ OLMAYAN bir değer BİLEREK
/// YOKTUR — "ölü sözlük, ölü iznin kardeşidir": tüketilmeyen bir enum değeri
/// tıpkı tüketilmeyen bir izin gibi, var olmayan bir yeteneği var gibi gösterir.
/// Değer EKLEMEK `ALTER TYPE … ADD VALUE` ile additive bir migration'dır;
/// ÇIKARMAK kolon kaldırmakla aynı iki-sürüm kuralına tabidir.
///
/// Bu enum TELE HİÇ ÇIKMAZ → tele-enum parite pini GEREKMEZ (karşılaştır:
/// `TenantStatus`/`TenantRole`, ikisi de tel sözleşmesinde kopyası olduğu için
/// pinli).
///
/// GÜNCELLEME (ROADMAP v0.0.15, T-016/S1 — TOTP 2FA + owner zorunluluğu):
/// `tenant_security_policy_changed` EKLENDİ. ⚠ Yalnızca KİRACI SEVİYESİ
/// zorunluluk değişikliği (`Tenant.requireTwoFactorForOwner` aç/kapat)
/// denetlenir — KULLANICI seviyesi 2FA aç/kapat olayı bu enum'a GİRMEZ ve
/// `audit_log`'a YAZILMAZ: `AuditLog.tenantId` NOT NULL ve tablo kiracı
/// kapsamlı, kullanıcı başına 2FA olayının atfedilecek bir kiracısı YOK
/// (2FA platform seviyesi bir kullanıcı özelliğidir) — bu enum değeri
/// EKLENMEDEN önce bu olgu doğrulanmalıydı, `architect` R-PM5 ile işaretledi.
enum AuditAction {
  member_invited
  member_invitation_accepted
  member_role_changed
  member_removed
  tenant_security_policy_changed

  @@map("audit_action")
}

/// Platform sürümünün yayın kanalı (ROADMAP v0.0.21, T-018/S2, ADR-0020). İKİ
/// değer — Sürüm Politikası §4'ün tanımladığı ÜÇÜNCÜ değer (`dev`) BİLEREK
/// YOKTUR ("ölü sözlük, ölü iznin kardeşidir"; `dev`'in bu sürümde tüketicisi
/// yok). Değer EKLEMEK `ALTER TYPE … ADD VALUE` ile additive'dir (vade:
/// v0.16.0, `docs` ROADMAP'e not düşer).
enum ReleaseChannel {
  stable
  canary

  @@map("release_channel")
}

/// Tema durumu (ROADMAP v0.0.21, T-018/S2). `hidden`/`internal` BİLEREK
/// YOKTUR — bu sürümde tek tüketici `active`/`deprecated` ayrımıdır
/// (ikinci bir tema yayınlandığında/eskisi çekildiğinde). Değer EKLEMEK
/// additive'dir.
enum ThemeStatus {
  active
  deprecated

  @@map("theme_status")
}

/// Tema sürümünün yayın durumu (ROADMAP v0.0.21, T-018/S2). `draft`'tan
/// `published`'a geçiş CHECK #1 (`theme_release_published_at_pairing_check`)
/// ile `publishedAt`'in eşzamanlı yazılmasını zorunlu kılar.
enum ThemeReleaseStatus {
  draft
  published
  deprecated

  @@map("theme_release_status")
}

/// Bir sürüm güncellemesini kimin/neyin başlattığı (ROADMAP v0.0.21, T-018/S2,
/// architect — `triggeredBy` serbest metin DEĞİL, discriminated union).
/// `tenant_user`: kiracı panelden tetikledi. `platform_auto`: platform
/// otomatik/zorunlu güvenlik yaması olarak tetikledi (CLAUDE.md §9).
enum UpdateTrigger {
  tenant_user
  platform_auto

  @@map("update_trigger")
}

/// Sürüm güncellemesinin durumu (ROADMAP v0.0.21, T-018/S2). ⚠⚠
/// `rolled_back` değeri BİLEREK YOKTUR (`AuditAction.revoked` emsali) — geri
/// alma kendi satırıdır, `TenantUpdateHistory.fromState`/`toState`'in yönü
/// onu zaten ayırt eder. Değer EKLEMEK additive'dir (vade: v0.16.0).
enum UpdateStatus {
  running
  completed
  failed

  @@map("update_status")
}
