// @arkesoft/db — Prisma şeması (ROADMAP v0.0.3, T-001 architect tasarımı)
//
// Ortak konvansiyon (ADR-0003):
//   - R2: `id` = `String @id @default(cuid(2))`, PostgreSQL tipi `text`, UZUNLUK SINIRI
//     YOK (`@db.VarChar` yasak), öneksiz. `@default(cuid(2))` Prisma'nın İSTEMCİ
//     tarafında üretilir, DDL'de bir `DEFAULT` ifadesi YOKTUR → ham SQL ile satır
//     eklerken `id` elle verilmek zorundadır (@paralleldrive/cuid2 eklenmez).
//   - R3: PostgreSQL'de `user` ayrılmış kelimedir (`SELECT user` bir rol döner).
//     Model adı `User` kalır (Better Auth v0.0.5 model adıyla eşler) ama tablo adı
//     `app_user`'dır — elle yazılan RLS/DDL SQL'i ve psql hata ayıklaması tırnaklı
//     `"user"`'a bağımlı kalmasın. Ayrılmış kelimeyle çakışan her platform tablosuna
//     aynı `app_` öneki konvansiyonu uygulanır.
//   - Zaman alanları `@db.Timestamptz(3)`; trigger yok, `updatedAt` istemci tarafında
//     `@updatedAt` ile yönetilir.
//   - Soft delete yalnızca VARLIK tablolarında (`Tenant`, `User`); saf ilişki tablosu
//     `TenantMembership`'te yoktur — kaldırma hard delete'tir (bkz. ADR-0003 madde 3).
//   - `Tenant` ve `User` PLATFORM SEVİYESİDİR, `tenant_id` TAŞIMAZLAR (V4). Tenant'a
//     bağlı tabloların KANONİK LİSTESİ bu dosyada DEĞİL, `src/tenancy.ts` →
//     `TENANT_SCOPED_TABLES` dizisindedir (makine okunur taksonomi; linter'lar o
//     diziyi tüketir). RLS politikaları v0.0.13'ten itibaren elle SQL olarak
//     migration'lara yazılır (bu şema dosyası RLS ÜRETMEZ — AC6 sapma riskine
//     girmesin).
//
// GÜNCELLEME (ROADMAP v0.0.5, T-006/S2 — Better Auth): `Session`/`Account`/
// `Verification` EKLENDİ, üçü de PLATFORM SEVİYESİ (`tenant_id` TAŞIMAZ) —
// gerekçe her modelin kendi doc yorumunda. `User`'a `emailVerified`/`image`
// additive alanları eklendi (A4/A-G1/A-G2, Task raporunda ÖLÇÜLDÜ). Bu üç yeni
// tablo için `(tenant_id, …)` bileşik indeks GEREKMEZ ve YAZILMAZ (platform
// tablosu). MADDE 2 — R-1 KARARI (ADR-0008 taslağı): bu üç tablonun sır taşıyan
// kolonları (`account.password`, `session.token`, `verification.value`) RLS
// İLE korunamaz (giriş/oturum arama asıldan ÖNCE gelir, `current_setting`'e
// dayalı yüklem tanımlanamaz) — koruma `src/client.ts` → `AUTH_SECRET_BEARING_MODELS`
// derleme zamanı daraltmasındadır, bu şema dosyası seviyesinde YOKTUR.
//
// GÜNCELLEME (ROADMAP v0.0.14, T-014/S1 — RBAC): `AuditLog` ve
// `TenantInvitation` EKLENDİ, ikisi de KİRACIYA BAĞLI → `src/tenancy.ts`'teki
// `TENANT_SCOPED_TABLES` İKİ üyeden DÖRT üyeye çıktı. `TenantRole` enum'u
// v0.0.3'ten beri beş rolü taşıyor, bu sürümde DEĞİŞMEDİ; yeni enum yalnızca
// `AuditAction`. `TenantInvitation` HAM BELİRTEÇ SAKLAMAZ (yalnızca sha256
// özeti) → `src/client.ts` → `AUTH_SECRET_BEARING_MODELS` ÜÇ üyede KALIR.

// `output = "../generated"` iki farklı "generated" konumunun KAYNAĞIDIR:
//   1. packages/db/generated/     — `prisma generate`'in ham TS çıktısı (KÖK, .gitignore'da)
//   2. packages/db/dist/generated/ — (1)'in `tsc -p tsconfig.prisma.json` ile derlenmiş hali
// `pnpm clean` (bkz. package.json → scripts.clean) ikisini de dist/.turbo ile birlikte
// siler — tam temizlik, clean sonrası `generate` yeniden koşulmalıdır.
// `pnpm build` (bkz. package.json → scripts.build) ise SADECE dist/'i temizler ve
// `find dist -mindepth 1 -maxdepth 1 ! -name generated` ile dist/generated'ı KORUR
// (K-B6b) — build, generate'in çıktısını silmeden üstüne derlenmiş kaynağı yazar.
// Bu iki davranış birbirine KARIŞTIRILMASIN.
generator client {
  provider     = "prisma-client"
  output       = "../generated"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

// Prisma 7: `datasource.url` şema dosyasında artık desteklenmiyor. Migrate için
// bağlantı URL'si `prisma.config.ts` → `datasource.url`'de; çalışma zamanında
// istemciye `@prisma/adapter-pg` üzerinden `pg.Pool` adaptörü verilir (R-A4).
datasource db {
  provider = "postgresql"
}

/// Platform seviyesi kiracı (mağaza) kaydı. `tenant_id` taşımaz — bu tablonun
/// kendisi tenant kimliğinin kaynağıdır (V4).
///
/// GÜNCELLEME (ROADMAP v0.0.10, T-012/S2, architect VERİ MODELİ): `themeId`/
/// `themeVersion` EKLENDİ — ikisi de `String?`, uzunluk sınırı YOK (`@db.VarChar`
/// yasak, dosya başı R2). `NOT NULL` BU SÜRÜMDE YOK (CLAUDE.md §10 md 10,
/// expand/contract); promosyon en erken v0.3.0, ayrı PR. DB seviyesinde
/// `DEFAULT` YOK — platform varsayılan teması tek kaynakta, vitrinin kayıt
/// defterinde yaşar (ADR-0002 Karar 5). Eşleşme değişmezi
/// `(theme_id IS NULL) = (theme_version IS NULL)` migration'da ham SQL CHECK
/// kısıtıyla (veya A-A4 ölçümü drift raporluyorsa tek kod yolunda) sağlanır —
/// bkz. `prisma/migrations/<ts>_tenant_theme_selection/migration.sql`.
model Tenant {
  id            String       @id @default(cuid(2))
  slug          String       @unique
  name          String
  status        TenantStatus @default(pending)
  planId        String?      @map("plan_id")
  primaryDomain String?      @unique @map("primary_domain")
  themeId       String?      @map("theme_id")
  themeVersion  String?      @map("theme_version")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(3)

  memberships TenantMembership[]
  // ROADMAP v0.0.11 (T-013/S2): `Job.tenant` ilişkisinin ZORUNLU karşı tarafı.
  // Prisma ilişkileri iki taraflıdır — bu satır olmadan `prisma generate`
  // doğrulama hatasıyla durur (emsal: yukarıdaki `memberships`). DDL ÜRETMEZ
  // (FK kolonu `job` tarafındadır).
  jobs        Job[]
  // ROADMAP v0.0.14 (T-014/S1): `AuditLog.tenant` ve `TenantInvitation.tenant`
  // ilişkilerinin ZORUNLU karşı tarafları — `jobs` ile AYNI gerekçe (Prisma
  // ilişkileri iki taraflıdır; bu iki satır olmadan `prisma generate` doğrulama
  // hatasıyla durur ve hata `Tenant` tarafını işaret eder). İkisi de DDL
  // ÜRETMEZ (FK kolonları `audit_log`/`tenant_invitation` tarafındadır).
  auditLogs   AuditLog[]
  invitations TenantInvitation[]

  @@map("tenant")
}

/// Platform seviyesi kullanıcı kaydı. Tablo adı `app_user` (R3) — model adı `User`.
///
/// GÜNCELLEME (ROADMAP v0.0.5, T-006/S2, architect A4/A-G1 — birebir ÖLÇÜLDÜ):
/// `emailVerified`/`image` Better Auth'un `User` modelinin BEKLEDİĞİ alanlardır
/// — `@better-auth/cli generate` çıktısıyla (ölçüm: betterAuth@1.7.14 +
/// prismaAdapter, bağlayıcı araç olarak kullanılan `@better-auth/cli@1.4.21`,
/// bkz. Task raporu "A-G1 ÖLÇÜMÜ") BİREBİR karşılaştırıldı, sapma YOK. Yalnızca
/// EKLEME (additive) — Better Auth'un Prisma adaptörü modele PRISMA MODEL
/// ADIYLA erişir (`prisma.user`), `@@map("app_user")`/`@map` ADAPTÖRE GÖRÜNMEZ
/// (A-G2) → `tenant_membership.user_id` FK'si DOKUNULMADAN `app_user.id`'ye
/// bakmaya devam eder (AC3). `sessions`/`accounts` yalnızca Prisma ilişki
/// alanlarıdır — DDL ÜRETMEZLER (Session/Account tarafındaki `@relation` FK
/// kolonunu zaten taşır).
model User {
  id            String     @id @default(cuid(2))
  email         String     @unique
  name          String
  status        UserStatus @default(active)
  emailVerified Boolean    @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz(3)

  memberships TenantMembership[]
  sessions    Session[]
  accounts    Account[]

  @@map("app_user")
}

/// Better Auth oturum kaydı. PLATFORM SEVİYESİ (`tenant_id` TAŞIMAZ) — oturum
/// KULLANICIYA bağlı, kiracıya değil ("bir hesap → birden fazla mağaza" vaadi
/// bunu zorunlu kılıyor); kiracı üyeliği kontrolü istek ANINDA
/// `tenant_membership` üzerinden yapılır (R2, v0.0.5 architect kararı).
///
/// `session`/`account`/`verification` PostgreSQL'de AYRILMIŞ KELİME DEĞİL →
/// `app_` öneki (R3) GEREKMEZ.
///
/// `ipAddress`/`userAgent` TANIMLANIR ama DOLDURULMAZ
/// (`advanced.ipAddress.disableIpTracking: true`, backend/S5 kapsamı) — K6
/// "zenginleştirilmiş meta veri yok" + KVKK (IP kişisel veri, saklama
/// politikası olmadan tutulmaz). Kolonun BUGÜN şemada olması v0.0.15'in
/// yıkıcı migration'a ihtiyaç duymamasını sağlayan bilinçli expand adımıdır.
///
/// MADDE 2 — R-1 KARARI (ADR-0008 taslağı): `token` oturumun TAŞIYICI kimlik
/// bilgisidir — RLS'le korunamaz (asıldan ÖNCE okunur). Koruma derleme
/// zamanında: bkz. `client.ts` → `AUTH_SECRET_BEARING_MODELS`.
model Session {
  id        String   @id @default(cuid(2))
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/// Better Auth kimlik bilgisi kaydı (e-posta/şifre + ileride sosyal sağlayıcı
/// bağlantıları). PLATFORM SEVİYESİ — kimlik bilgisi (parola hash'i) HESABA
/// aittir, kiracıya değil.
///
/// `(provider_id, account_id)` BİLEŞİK BENZERSİZLİK kısıtı: aynı sağlayıcı +
/// sağlayıcı hesap kimliği ikinci bir satıra bağlanamaz (architect VERİ
/// MODELİ, indeks listesi).
///
/// MADDE 2 — R-1 KARARI: `password` parola HASH'idir — RLS'le korunamaz
/// (giriş anında, asıldan ÖNCE okunur zorundadır). Koruma derleme zamanında:
/// bkz. `client.ts` → `AUTH_SECRET_BEARING_MODELS`.
model Account {
  id                    String    @id @default(cuid(2))
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

/// Better Auth doğrulama/sıfırlama belirteç kaydı (e-posta doğrulama, şifre
/// sıfırlama). PLATFORM SEVİYESİ — belirteç e-posta KİMLİĞİNE bağlıdır, giriş
/// anında kiracı bilgisi henüz yok (R1).
///
/// MADDE 2 — R-1 KARARI: `value` HAM belirteçtir — RLS'le korunamaz. Koruma
/// derleme zamanında: bkz. `client.ts` → `AUTH_SECRET_BEARING_MODELS`.
///
/// `User` ile İLİŞKİSİ YOK (Better Auth `identifier`'ı serbest metin olarak
/// tutar, FK kurmaz) — bu tablo model olarak `User`'dan bağımsızdır.
model Verification {
  id         String   @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

/// Tenant'a bağlı tablo — `TENANT_SCOPED_TABLES`'ın BİRİNCİ üyesi. Taksonominin
/// kanonik listesi `src/tenancy.ts`'tedir ve v0.0.14'ten itibaren DÖRT üyelidir
/// (`tenant_membership`, `job`, `audit_log`, `tenant_invitation`).
/// RLS zemini: `tenant_id` kolonu tam olarak bu adla, `text`, NOT NULL ve
/// `(tenant_id, user_id)` bileşik benzersizlik kısıtının öncü kolonu; politika
/// `<ts>_rls_tenant_isolation/migration.sql`'de.
/// Soft delete YOK — üyelik kaldırma hard delete'tir (ADR-0003 madde 3).
model TenantMembership {
  id        String     @id @default(cuid(2))
  tenantId  String     @map("tenant_id")
  userId    String     @map("user_id")
  role      TenantRole
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // ⚠ KURAL (ROADMAP v0.0.14, T-014/S1, architect K-A12 — R-A10'un BU SÜRÜMDEKİ
  // karşılanma biçimi): aşağıdaki `onDelete: Cascade` BİLEREK DEĞİŞTİRİLMEDİ.
  // INV-OWNER ("her kiracının tam olarak bir `owner`'ı var") KODDA zorlanır
  // (`apps/api`, CAS deseni) → `member.remove`/`member.updateRole` yoluyla
  // sahipsiz kiracı üretmek İMKÂNSIZ. Sahipsiz kiracı üretebilecek TEK yol
  // `app_user` hard delete'idir ve ÜRETİMDE O YOL YOKTUR (ölçüldü: kullanıcı
  // hard delete'i yalnızca `packages/db/src/__tests__/**` içinde; kimlik
  // doğrulama yüzeyinde kullanıcı silme ucu yok). Bu kuralın GÜÇLÜ (veritabanı)
  // biçimi — FK aksiyonunu `Restrict`'e çevirmek — v0.0.19'a (hesap silme/GDPR
  // yüzeyi) SIRALANDI, düşürülmedi: bugün çevirmek migration'da kısıt kaldırma
  // ifadesi gerektirir, migration linter'ının yıkıcı-ifade kuralı kırmızıya
  // döner ve kuralı gevşetme baskısı doğar (CLAUDE.md §10 md 6). ⚠ Borç satırı
  // KAPANMADI, TAŞINDI.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_membership")
}

/// Kiracıya bağlı arka plan işi kaydı (ROADMAP v0.0.11, T-013/S2, architect K3
/// birebir). `TENANT_SCOPED_TABLES`'ın İKİNCİ üyesi — ⚠ dizinin KENDİSİ
/// v0.0.14'ten (T-014/S1) itibaren DÖRT üyelidir (`audit_log` ve
/// `tenant_invitation` eklendi); bu sıra numarası eklenme sırasıdır, dizinin
/// uzunluğu DEĞİL. `tenant_membership`'in
/// taşıdığı tüm değişmezleri (CLAUDE.md §7 md 1-3) taşır: `tenant_id` `text`
/// NOT NULL, RLS `ENABLE`+`FORCE`, kanonik `USING`/`WITH CHECK` politikası
/// (bkz. `<ts>_job_table/migration.sql`) ve `tenant_id` öncü bileşik indeksler.
///
/// `@@unique([tenantId, id])` DEKORATİF DEĞİL, ZORUNLU (architect R-A1):
/// `Job`'un doğal bileşik benzersizliği YOKTUR (`tenant_membership` bunu
/// `(tenant_id, user_id)` ile doğal olarak karşılıyordu), ama CLAUDE.md §7 md 3
/// her kiracı tablosundan `tenant_id` öncü BİLEŞİK indeks istiyor ve migration
/// linter'ı (`__tests__/helpers/migration-set.ts`,
/// `MISSING_TENANT_ID_LEADING_UNIQUE_INDEX`) bunu mekanik olarak zorluyor.
/// Fonksiyonel gerekçe: RLS her sorguya `tenant_id = current_setting(...)`
/// yüklemini EKLER → `job.get`'in fiili yüklemi zaten `(tenant_id, id)`'dir,
/// yani bu o sorgunun İDEAL indeksidir.
///
/// `status` Prisma `enum`'u (String + Zod union DEĞİL): geçersiz durum DB
/// seviyesinde mekanik olarak imkânsız; Prisma'nın ürettiği enum tam literal
/// union verdiği için §4'ün "exhaustive switch + assertNever" şartıyla
/// ÇATIŞMAZ. `cancelled` YOK (`job.cancel` v0.0.11 kapsamı dışında) —
/// sonradan eklenmesi `ALTER TYPE … ADD VALUE` ile additive'dir.
///
/// `payload`/`error` → `Json` (Prisma+PG varsayılanı `jsonb`; `@db.Json`
/// YAZILMAZ). İkisi de okunurken Zod ile parse edilir (§4) — şemaları
/// `apps/api` tarafında yaşar, `payload` tele HİÇ ÇIKMAZ. `error`
/// `@arkesoft/errors` → `toErrorBody()`'nin birebir çıktısıdır; `AppError.context`
/// o gövdeye ASLA girmez, dolayısıyla bu kolon sır/PII TAŞIMAZ.
///
/// Soft delete YOK — iş kaydı olgusal bir denetim izidir; silme/retention
/// politikası v0.0.17 kapsamındadır.
model Job {
  id          String    @id @default(cuid(2))
  tenantId    String    @map("tenant_id")
  type        String
  status      JobStatus @default(queued)
  progress    Int       @default(0)
  payload     Json
  error       Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("job")
}

/// Kiracıya bağlı denetim kaydı (ROADMAP v0.0.14, T-014/S1, architect K-A1
/// birebir). `TENANT_SCOPED_TABLES`'ın ÜÇÜNCÜ üyesi — `tenant_membership` ve
/// `job`'un taşıdığı tüm değişmezleri (CLAUDE.md §7 md 1-3) taşır: `tenant_id`
/// `text` NOT NULL, RLS `ENABLE`+`FORCE`, kanonik `USING`/`WITH CHECK`
/// politikası (bkz. `<ts>_rbac_audit_log_and_invitation/migration.sql`) ve
/// `tenant_id` öncü bileşik indeksler.
///
/// APPEND-ONLY. `updatedAt` BİLEREK YOK: satır yazıldıktan sonra DEĞİŞMEZ,
/// bir UPDATE yolu yoktur. `@updatedAt` eklemek "bu satır güncellenebilir"
/// anlamı taşır ve yanlış bir sözleşme beyan eder. Soft delete de YOK —
/// denetim izinin silinmesi bir saklama (retention) politikası kararıdır,
/// v0.0.17 kapsamındadır.
///
/// ⚠ `actorUserId` için YABANCI ANAHTAR YOKTUR ve bu bilinçli: denetim izi
/// aktörden UZUN YAŞAR. `Cascade` olsaydı bir kullanıcı silindiğinde onun
/// yaptığı her yetki değişikliğinin kaydı da giderdi (denetim izinin varlık
/// sebebini yok eder); `Restrict` olsaydı kullanıcı silmek denetim kaydı
/// yüzünden kilitlenirdi. Kolon bu yüzden ilişkisiz bir `text`'tir —
/// "o anda aktör kimdi" olgusunu saklar, canlı bir referans TUTMAZ.
///
/// `action` Prisma `enum`'u (`Job.status` emsali): geçersiz değer veritabanı
/// seviyesinde mekanik olarak imkânsız. ⚠ `revoked` gibi TÜKETİCİSİ OLMAYAN bir
/// değer BİLEREK YOKTUR ("ölü sözlük = ölü iznin kardeşi"); değer EKLEMEK
/// `ALTER TYPE … ADD VALUE` ile additive'dir. Bu enum TELE HİÇ ÇIKMAZ
/// (denetim kaydını okuyan bir prosedür bu sürümde yok) → `TenantStatus`/
/// `TenantRole` için gereken tele-enum parite pini BU enum için GEREKMEZ.
///
/// `subject` TEK kolondur ve anlamı KAPALI ve YAZILIDIR: `member_invited` →
/// `invitationId`; diğer üç değer → `userId`. Zincir `diff.invitationId`
/// üzerinden kurulur. ⚠ E-POSTA `audit_log`'a HİÇ GİRMEZ — beklemedeki adres
/// `tenant_invitation.email`'de yaşar.
///
/// `diff` → `Json` (Prisma+PG varsayılanı `jsonb`; `@db.Json` YAZILMAZ).
/// Okunurken Zod ile parse edilir (CLAUDE.md §4) ve YAZILIRKEN de bir Zod
/// kapısından geçer — şemalar `apps/api` tarafında yaşar (eylem başına ayrı
/// şema; fazla anahtar DÜŞÜRÜLÜR). Bu kolon bu yüzden sır/PII TAŞIMAZ.
///
/// `ip`/`userAgent` kişisel veri sınıfındadır AMA denetim kaydının VARLIK
/// SEBEBİDİR — CLAUDE.md §4'ün "asla loglanmaz" listesinde yoktur: SAKLANIR,
/// LOGLANMAZ.
///
/// `@@unique([tenantId, id])` DEKORATİF DEĞİL, ZORUNLU (`Job`'un birebir aynı
/// durumu): bu tablonun doğal bir bileşik benzersizliği YOKTUR (aynı aktör aynı
/// özneye aynı eylemi iki kez uygulayabilir — denetim kaydı bunu İKİ SATIR
/// olarak tutmak zorundadır), ama CLAUDE.md §7 md 3 her kiracı tablosundan
/// `tenant_id` öncü BİLEŞİK indeks istiyor ve migration linter'ı
/// (`__tests__/helpers/migration-set.ts`,
/// `MISSING_TENANT_ID_LEADING_UNIQUE_INDEX`) bunu mekanik olarak zorluyor.
model AuditLog {
  id          String      @id @default(cuid(2))
  tenantId    String      @map("tenant_id")
  actorUserId String      @map("actor_user_id")
  action      AuditAction
  subject     String
  diff        Json
  ip          String?
  userAgent   String?     @map("user_agent")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_log")
}

/// Kiracıya bağlı, HENÜZ KABUL EDİLMEMİŞ üyelik daveti (ROADMAP v0.0.14,
/// T-014/S1, architect K-A1 + K-A0). `TENANT_SCOPED_TABLES`'ın DÖRDÜNCÜ üyesi.
///
/// NEDEN AYRI BİR TABLO: davet kabul edilirken kullanıcı HENÜZ VAR OLMAYABİLİR
/// (`TenantMembership.userId` NOT NULL + `app_user`'a FK) → üyeliği "beklemede"
/// olarak önceden yazmak imkânsız. Better Auth'un `verification` tablosu da
/// kullanılamaz (sır taşıyan üç tablodan biri; erişimi derleme zamanında
/// `AuthModule`'e daraltılmış — bkz. `src/client.ts`).
///
/// ⚠ HAM BELİRTEÇ SAKLANMAZ — yalnızca `tokenHash` (sha256 özeti). İki sonucu
/// var ve ikisi de bağlayıcı: (1) bu model `src/client.ts`'in
/// `AUTH_SECRET_BEARING_MODELS` listesine GİRMEZ (o liste ÜÇ üyede kalır) ve
/// (2) kimlik bilgisi taşıyan kolonların sayısını büyütmediği için v0.0.14.1'in
/// (kimlik doğrulama rolü ayrımı) kapsamını BÜYÜTMEZ.
///
/// `email` KÜÇÜK HARFE NORMALİZE EDİLEREK yazılır ve karşılaştırılır. Bu bir
/// veritabanı kısıtı DEĞİL, yazma/okuma yolunun sözleşmesidir (uygulaması
/// `apps/api`, T-014/S4) — `@@unique([tenantId, email])` ancak normalize
/// edilmiş değerlerle anlamlıdır: aksi halde `A@x.com` ve `a@x.com` İKİ ayrı
/// bekleyen davet üretir ve "zaten davet edilmiş mi" kontrolü atlanır.
///
/// SOFT DELETE YOK: davet kabul edildiğinde satır SİLİNİR (belirteç tek
/// kullanımlık; ikinci kabul denemesi "geçersiz davet" alır). `updatedAt` VAR
/// — tekrar davet aynı satırı günceller (`upsert`), yani bu tablo `AuditLog`'un
/// aksine GERÇEKTEN güncellenir.
///
/// ⚠ İLİŞKİ/FK KARARI (T-014/S1, `db` ajanının kararı — architect K-A1 bu satırı
/// BELİRTMEMİŞTİ, `po` R-PO6 ile işaretledi):
///   - `tenant` → `onDelete: Cascade`. Gerekçe MEKANİK: kiracı silindiğinde
///     bekleyen davetler YETİM kalırsa izolasyon süitinin kiracı temizliği
///     (`cleanupTenant`) satır bırakır ve çapraz kiracı okuma senaryosu
///     SIZDIRIR. `TenantMembership`/`Job`'un birebir aynı kararı.
///   - `invitedByUserId` → FK YOK. Gerekçe `AuditLog.actorUserId` ile AYNI:
///     "daveti kim gönderdi" bir OLGUDUR; davet eden kullanıcının silinmesi ne
///     bekleyen daveti geçersiz kılmalı (Cascade) ne de kullanıcı silmeyi
///     kilitlemeli (Restrict). Kolon ilişkisiz bir `text`'tir.
///
/// İNDEKS GEREKÇESİ (yalnızca iki, üçüncüsü BİLEREK yok):
///   - `@@unique([tenantId, email])` — DOĞAL benzersizlik. Bu yüzden `Job`/
///     `AuditLog`'un ihtiyaç duyduğu yapay `@@unique([tenantId, id])`
///     GEREKMEZ (migration linter'ının `tenant_id` öncü UNIQUE INDEX şartı
///     bu kısıtla zaten karşılanıyor).
///   - `@@unique([tenantId, tokenHash])` — kabul sorgusunun İDEAL indeksi
///     (RLS her sorguya `tenant_id = …` yüklemini zaten EKLER, dolayısıyla
///     fiili yüklem `(tenant_id, token_hash)`'tir).
///   - `expiresAt` üzerinde indeks YOK: süresi geçmiş davet SORGULANMAZ,
///     yalnızca tek satır okunurken kontrol edilir. Gereksiz indeks yazma
///     yüküne maliyettir — bu tablo davet başına yazılır, taranmaz.
model TenantInvitation {
  id              String     @id @default(cuid(2))
  tenantId        String     @map("tenant_id")
  email           String
  role            TenantRole
  tokenHash       String     @map("token_hash")
  invitedByUserId String     @map("invited_by_user_id")
  expiresAt       DateTime   @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@unique([tenantId, tokenHash])
  @@map("tenant_invitation")
}

/// Kiracı durumu. `deleted` değeri YOKTUR (A-V8) — silinmişliğin tek doğruluk
/// kaynağı `Tenant.deletedAt`'tir.
enum TenantStatus {
  pending
  provisioning
  active
  suspended

  @@map("tenant_status")
}

/// Kullanıcı durumu. Abonelik/ödeme durumları bu alana karışmaz (V3).
enum UserStatus {
  active
  suspended

  @@map("user_status")
}

/// Üyelik rolü. `platform_admin` YOKTUR — platform yetkisi, üyelik değildir.
enum TenantRole {
  owner
  admin
  staff
  support
  readonly

  @@map("tenant_role")
}

/// Arka plan işi durumu (ROADMAP v0.0.11, T-013/S2). Dört terminal olmayan/
/// terminal durum: `queued` (kuyrukta) → `running` (bir worker aldı) →
/// `completed` | `failed`. `cancelled` BİLEREK YOK — `job.cancel` bu sürümün
/// kapsamı dışında; değer EKLEMEK additive bir migration'dır, ÇIKARMAK
/// kolon silmekle aynı iki-sürüm kuralına tabidir.
enum JobStatus {
  queued
  running
  completed
  failed

  @@map("job_status")
}

/// Denetim kaydı eylemi (ROADMAP v0.0.14, T-014/S1, architect K-A1). Bu sürümün
/// kapsamındaki TEK olay sınıfı "yetki değişikliği"dir ve dört değerin DÖRDÜ DE
/// tüketilir (davet et → kabul → rol değiştir → çıkar).
///
/// ⚠ `revoked` (daveti geri çekme) gibi TÜKETİCİSİ OLMAYAN bir değer BİLEREK
/// YOKTUR — "ölü sözlük, ölü iznin kardeşidir": tüketilmeyen bir enum değeri
/// tıpkı tüketilmeyen bir izin gibi, var olmayan bir yeteneği var gibi gösterir.
/// Değer EKLEMEK `ALTER TYPE … ADD VALUE` ile additive bir migration'dır;
/// ÇIKARMAK kolon kaldırmakla aynı iki-sürüm kuralına tabidir.
///
/// Bu enum TELE HİÇ ÇIKMAZ → tele-enum parite pini GEREKMEZ (karşılaştır:
/// `TenantStatus`/`TenantRole`, ikisi de tel sözleşmesinde kopyası olduğu için
/// pinli).
enum AuditAction {
  member_invited
  member_invitation_accepted
  member_role_changed
  member_removed

  @@map("audit_action")
}
