{
  // Derleme projesi: yalnızca src/ TypeScript kaynaklarını dist/'e üretir.
  // Testler (`src/__tests__/**`) derlenmez — paket yalnızca üretim kodunu dağıtır
  // (packages/db deseninin birebir kopyası, PO A-P3).
  "extends": "@arkesoft/config/tsconfig/node.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/.tsbuildinfo",

    // --- NestJS dekoratör uyumu — tsconfig.json ile BİREBİR aynı (R2) ---
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/__tests__"]
}
