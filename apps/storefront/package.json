{
  "name": "@arkesoft/storefront",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Çok kiracılı vitrin (Astro SSR) — tema runtime",
  "scripts": {
    "dev": "env -u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT -u AI_AGENT astro dev",
    "build": "astro build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --fsModuleCachePath node_modules/.vitest-cache",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "clean": "rm -rf dist .turbo .astro"
  },
  "dependencies": {
    "@arkesoft/tenancy": "workspace:*",
    "@arkesoft/trpc": "workspace:*",
    "@arkesoft/errors": "workspace:*",
    "@arkesoft/themes-modern": "workspace:*",
    "astro": "catalog:",
    "@astrojs/node": "catalog:",
    "@astrojs/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arkesoft/config": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
