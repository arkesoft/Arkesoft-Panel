# Arkesoft pnpm yapılandırması — ROADMAP v0.0.1

# Peer bağımlılık uyumsuzluğu sessizce geçilmez; kurulum hata verir.
strict-peer-dependencies=true

# Workspace içi paketler daima yerelden bağlanır, registry'den çekilmez.
link-workspace-packages=true

# package.json içinde workspace:* protokolü korunur.
save-workspace-protocol=rolling

# Kurulumda kullanılmayan bağımlılık uyarısı görünür kalsın.
dedupe-peer-dependents=true
